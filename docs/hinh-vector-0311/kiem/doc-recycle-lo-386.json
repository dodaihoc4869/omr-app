  "publicQuestions": [
    {
      "qid": "VIP27-C4-B14-D1-I-17",
      "de": "Sử dụng thông tin dưới đây để trả lời các câu số 17 – 18: Cho các vật liệu polymer thuộc loại chất dẻo mô tả như hình dưới đây. Các polymer này có thể tái chế được, các kí hiệu này thường được in trên bao bì, vỏ hộp, đồ dùng,… để giúp nhận biết vật liệu polymer cũng như thuận lợi trong việc thu gom và tái chế.\nTrong đời sống, nhiều hộ gia đình có thói quen tái sử dụng nhiều lần các chai nhựa đựng nước tinh khiết (thường có kí hiệu số 1 - PET) để đựng nước sôi hoặc nước trà nóng. Dưới góc độ hoá học và tính chất vật liệu, phát biểu nào sau đây đánh giá đúng nhất về thói quen này?",
      "allHinh": [
        {
          "hash": "5518f8180cbb31e2158c8eab5bd299bcf2263fa9471bf59791f34576e4865565",
          "where": "VIP27-C4-B14-D1-I-17.hinh.0.du_lieu",
