{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "nhat-ky-bai-day/kich-ban/1",
 "title": "Kịch bản «Nhật ký bài dạy»: phần GEMINI sinh ra sau mỗi buổi live (nghe tieng.mp3 + xem ảnh trang bảng)",
 "description": "Gửi kèm lệnh gọi Gemini API (generationConfig.responseMimeType = application/json, responseJsonSchema = lược đồ này). Chỉ 7 khuôn. Viết chặt cho mọi bộ sinh JSON có ràng buộc: mọi object additionalProperties false, MỌI trường required, chỉ 3 chỗ anyOf, không null (chuỗi rỗng / 0 / mảng rỗng = «không có»), không minimum / maximum / maxLength / maxItems, không đệ quy. Phần MÁY điền sau, không nằm trong lược đồ: buoi, nguon (đầu tệp), canh[].nguon.vung (từ nét trong đoạn tu đến den), tong-ket y[].giay. Không có trường nào chứa độ âm điện của nguyên tố có ky: máy tra bảng của mình. Không có bước người duyệt: cổng tự kiểm trong khuon.js quyết định cảnh nào được phát hành.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "phienBan",
  "bia",
  "canh"
 ],
 "properties": {
  "phienBan": {
   "const": 2
  },
  "bia": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "loi",
    "hoatHoa"
   ],
   "properties": {
    "loi": {
     "type": "string",
     "description": "Một câu mời học, xưng Thầy, không quá 30 chữ."
    },
    "hoatHoa": {
     "anyOf": [
      {
       "$ref": "#/$defs/moKeoCo"
      },
      {
       "$ref": "#/$defs/moQuyTac"
      }
     ]
    }
   }
  },
  "canh": {
   "type": "array",
   "minItems": 1,
   "items": {
    "anyOf": [
     {
      "$ref": "#/$defs/canhKeoCo"
     },
     {
      "$ref": "#/$defs/canhThang"
     },
     {
      "$ref": "#/$defs/canhLewis"
     },
     {
      "$ref": "#/$defs/canhQuyTac"
     },
     {
      "$ref": "#/$defs/canhViDu"
     },
     {
      "$ref": "#/$defs/canhDoanNhanh"
     },
     {
      "$ref": "#/$defs/canhTongKet"
     }
    ]
   }
  }
 },
 "$defs": {
  "chu": {
   "type": "string",
   "description": "Chữ cho học sinh: xưng Thầy, câu không quá 30 chữ, không emoji, không dấu gạch ngang dài, không viết tắt của bảng (VD, LK, CHT…). Được dùng **…** để nhấn."
  },
  "dsChu": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/chu"
   }
  },
  "loai": {
   "enum": [
    "khong-phan-cuc",
    "phan-cuc",
    "ion"
   ]
  },
  "ky": {
   "enum": [
    "H",
    "C",
    "N",
    "O",
    "F",
    "Na",
    "Cl",
    "K"
   ],
   "description": "Chỉ nguyên tố có trong bảng độ âm điện của app."
  },
  "kyHoacRong": {
   "enum": [
    "",
    "H",
    "C",
    "N",
    "O",
    "F",
    "Na",
    "Cl",
    "K"
   ]
  },
  "nguon": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "trang",
    "cot",
    "tu",
    "den",
    "chep"
   ],
   "properties": {
    "trang": {
     "type": "integer",
     "description": "Số trang ảnh bảng (1, 2, …) mà cảnh lấy nội dung. 0 = không có nguồn (máy sẽ bỏ cảnh)."
    },
    "cot": {
     "enum": [
      "trai",
      "phai",
      "ca-bang"
     ]
    },
    "tu": {
     "type": "number",
     "description": "Giây trên trục tiếng của buổi, lúc Thầy bắt đầu nói phần này."
    },
    "den": {
     "type": "number",
     "description": "Giây lúc Thầy nói xong phần này."
    },
    "chep": {
     "type": "string",
     "description": "Chép NGUYÊN VĂN chữ trên bảng ở vùng đó (kể cả viết tắt). Không hiện cho học sinh; máy dùng để kiểm nguồn."
    }
   }
  },
  "benKeo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "nhan",
    "ky"
   ],
   "properties": {
    "nhan": {
     "type": "string"
    },
    "ky": {
     "$ref": "#/$defs/kyHoacRong"
    }
   }
  },
  "duKeoCo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "anSo",
    "thanhPha",
    "trai",
    "phai",
    "pha"
   ],
   "properties": {
    "anSo": {
     "type": "boolean",
     "description": "true: lực kéo minh hoạ, không in số."
    },
    "thanhPha": {
     "type": "boolean"
    },
    "trai": {
     "$ref": "#/$defs/benKeo"
    },
    "phai": {
     "$ref": "#/$defs/benKeo"
    },
    "pha": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "chiTrai",
       "chiPhai",
       "loai",
       "chu",
       "ketLuan"
      ],
      "properties": {
       "chiTrai": {
        "type": "number",
        "description": "Chỉ dùng khi không có ky (số minh hoạ). Có ky thì ghi 0: app tra bảng."
       },
       "chiPhai": {
        "type": "number"
       },
       "loai": {
        "$ref": "#/$defs/loai"
       },
       "chu": {
        "type": "string"
       },
       "ketLuan": {
        "type": "string",
        "description": "Chuỗi rỗng: app dùng tên loại liên kết."
       }
      }
     }
    }
   }
  },
  "duThang": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "max",
    "kim",
    "ketLuan"
   ],
   "properties": {
    "max": {
     "type": "number"
    },
    "kim": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "nhan",
       "a",
       "b",
       "delta",
       "loai"
      ],
      "properties": {
       "nhan": {
        "type": "string"
       },
       "a": {
        "$ref": "#/$defs/ky"
       },
       "b": {
        "$ref": "#/$defs/ky"
       },
       "delta": {
        "type": "number",
        "description": "Δχ A.I đọc hoặc tính; app tính lại từ bảng và so."
       },
       "loai": {
        "$ref": "#/$defs/loai"
       }
      }
     }
    },
    "ketLuan": {
     "type": "string",
     "description": "Kết luận khung phấn dưới thang; chuỗi rỗng nếu không có."
    }
   }
  },
  "duLewis": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "congThuc",
    "nguyenTu",
    "lienKet",
    "capRieng",
    "nhanChung"
   ],
   "properties": {
    "congThuc": {
     "type": "string"
    },
    "nguyenTu": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ky",
       "kieu",
       "vt"
      ],
      "properties": {
       "ky": {
        "type": "string"
       },
       "kieu": {
        "enum": [
         "cham",
         "x"
        ]
       },
       "vt": {
        "type": "array",
        "items": {
         "type": "integer"
        },
        "description": "[cột, hàng] trên lưới; mảng rỗng = xếp một hàng."
       }
      }
     }
    },
    "lienKet": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "a",
       "b",
       "cap"
      ],
      "properties": {
       "a": {
        "type": "integer"
       },
       "b": {
        "type": "integer"
       },
       "cap": {
        "type": "integer",
        "description": "Số cặp electron dùng chung (1, 2, 3)."
       }
      }
     }
    },
    "capRieng": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "nhanChung": {
     "type": "string"
    }
   }
  },
  "duQuyTac": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "nhan",
    "mau",
    "dong",
    "viDu"
   ],
   "properties": {
    "nhan": {
     "type": "string"
    },
    "mau": {
     "enum": [
      "vang",
      "ngoc",
      "hong"
     ]
    },
    "dong": {
     "$ref": "#/$defs/dsChu"
    },
    "viDu": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "duViDu": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "de",
    "soDo",
    "tinh"
   ],
   "properties": {
    "de": {
     "type": "string"
    },
    "soDo": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "chat",
      "muiTen"
     ],
     "properties": {
      "chat": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "ct",
         "heSo",
         "so"
        ],
        "properties": {
         "ct": {
          "type": "string"
         },
         "heSo": {
          "type": "integer",
          "description": "0 = không ghi hệ số."
         },
         "so": {
          "type": "array",
          "description": "Số liệu đề cho, ghi theo CỘT DỌC dưới chất (tư duy của Thầy).",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "hien",
            "chi",
            "M"
           ],
           "properties": {
            "hien": {
             "type": "string"
            },
            "chi": {
             "$ref": "#/$defs/kyHoacRong"
            },
            "M": {
             "type": "number",
             "description": "0 = ô này không phải khối lượng mol."
            }
           }
          }
         }
        }
       }
      },
      "muiTen": {
       "type": "array",
       "description": "Mũi tên giữa hai chất liền nhau; mảng rỗng = không có mũi tên.",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "tren"
        ],
        "properties": {
         "tren": {
          "type": "string",
          "description": "Hiệu suất ghi trên mũi tên."
         }
        }
       }
      }
     }
    },
    "tinh": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "ten",
      "thuaSo",
      "ketQua"
     ],
     "properties": {
      "ten": {
       "type": "string"
      },
      "thuaSo": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "dau",
         "hien",
         "gt",
         "tu",
         "mau",
         "tro",
         "loai",
         "ct",
         "nt",
         "tuCt",
         "denCt",
         "H"
        ],
        "properties": {
         "dau": {
          "enum": [
           "",
           "·",
           "−",
           "+"
          ]
         },
         "hien": {
          "type": "string"
         },
         "gt": {
          "type": "number"
         },
         "tu": {
          "type": "number"
         },
         "mau": {
          "type": "number",
          "description": "0 = không phải phân số."
         },
         "tro": {
          "type": "string",
          "description": "Ô liên quan sáng lên: «chất:ô» (0:1), «muiTen:0», «chất:heSo»; chuỗi rỗng = không."
         },
         "loai": {
          "enum": [
           "",
           "chia-M",
           "nhan-M",
           "bao-toan",
           "hieu-suat-xuoi",
           "hieu-suat-nguoc",
           "doi-don-vi"
          ]
         },
         "ct": {
          "type": "string"
         },
         "nt": {
          "type": "string"
         },
         "tuCt": {
          "type": "string"
         },
         "denCt": {
          "type": "string"
         },
         "H": {
          "type": "number"
         }
        }
       }
      },
      "ketQua": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "hien",
        "gt",
        "donVi"
       ],
       "properties": {
        "hien": {
         "type": "string"
        },
        "gt": {
         "type": "number"
        },
        "donVi": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "duDoanNhanh": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "hoi",
    "luaChon",
    "giai",
    "mo"
   ],
   "properties": {
    "hoi": {
     "$ref": "#/$defs/chu"
    },
    "luaChon": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "chu",
       "dung"
      ],
      "properties": {
       "chu": {
        "type": "string"
       },
       "dung": {
        "type": "boolean"
       }
      }
     }
    },
    "giai": {
     "$ref": "#/$defs/chu"
    },
    "mo": {
     "anyOf": [
      {
       "$ref": "#/$defs/moKeoCo"
      },
      {
       "$ref": "#/$defs/moThang"
      },
      {
       "$ref": "#/$defs/moLewis"
      },
      {
       "$ref": "#/$defs/moQuyTac"
      }
     ]
    }
   }
  },
  "duTongKet": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "y"
   ],
   "properties": {
    "y": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "chu",
       "canh"
      ],
      "properties": {
       "chu": {
        "$ref": "#/$defs/chu"
       },
       "canh": {
        "type": "string",
        "description": "id cảnh; app lấy phút nghe từ nét của cảnh đó."
       }
      }
     }
    }
   }
  },
  "moKeoCo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "khuon",
    "duLieu"
   ],
   "properties": {
    "khuon": {
     "const": "keo-co"
    },
    "duLieu": {
     "$ref": "#/$defs/duKeoCo"
    }
   }
  },
  "moThang": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "khuon",
    "duLieu"
   ],
   "properties": {
    "khuon": {
     "const": "thang-delta"
    },
    "duLieu": {
     "$ref": "#/$defs/duThang"
    }
   }
  },
  "moLewis": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "khuon",
    "duLieu"
   ],
   "properties": {
    "khuon": {
     "const": "lewis"
    },
    "duLieu": {
     "$ref": "#/$defs/duLewis"
    }
   }
  },
  "moQuyTac": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "khuon",
    "duLieu"
   ],
   "properties": {
    "khuon": {
     "const": "quy-tac"
    },
    "duLieu": {
     "$ref": "#/$defs/duQuyTac"
    }
   }
  },
  "canhKeoCo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "khuon",
    "tieuDe",
    "nguon",
    "loi",
    "khop",
    "duLieu"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "khuon": {
     "const": "keo-co"
    },
    "tieuDe": {
     "$ref": "#/$defs/chu"
    },
    "nguon": {
     "$ref": "#/$defs/nguon"
    },
    "loi": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cau"
     }
    },
    "khop": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "description": "Bước k của khuôn bắt đầu đúng lúc Thầy nói câu khop[k] (chỉ số trong loi)."
    },
    "duLieu": {
     "$ref": "#/$defs/duKeoCo"
    }
   }
  },
  "canhThang": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "khuon",
    "tieuDe",
    "nguon",
    "loi",
    "khop",
    "duLieu"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "khuon": {
     "const": "thang-delta"
    },
    "tieuDe": {
     "$ref": "#/$defs/chu"
    },
    "nguon": {
     "$ref": "#/$defs/nguon"
    },
    "loi": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cau"
     }
    },
    "khop": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "description": "Bước k của khuôn bắt đầu đúng lúc Thầy nói câu khop[k] (chỉ số trong loi)."
    },
    "duLieu": {
     "$ref": "#/$defs/duThang"
    }
   }
  },
  "canhLewis": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "khuon",
    "tieuDe",
    "nguon",
    "loi",
    "khop",
    "duLieu"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "khuon": {
     "const": "lewis"
    },
    "tieuDe": {
     "$ref": "#/$defs/chu"
    },
    "nguon": {
     "$ref": "#/$defs/nguon"
    },
    "loi": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cau"
     }
    },
    "khop": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "description": "Bước k của khuôn bắt đầu đúng lúc Thầy nói câu khop[k] (chỉ số trong loi)."
    },
    "duLieu": {
     "$ref": "#/$defs/duLewis"
    }
   }
  },
  "canhQuyTac": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "khuon",
    "tieuDe",
    "nguon",
    "loi",
    "khop",
    "duLieu"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "khuon": {
     "const": "quy-tac"
    },
    "tieuDe": {
     "$ref": "#/$defs/chu"
    },
    "nguon": {
     "$ref": "#/$defs/nguon"
    },
    "loi": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cau"
     }
    },
    "khop": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "description": "Bước k của khuôn bắt đầu đúng lúc Thầy nói câu khop[k] (chỉ số trong loi)."
    },
    "duLieu": {
     "$ref": "#/$defs/duQuyTac"
    }
   }
  },
  "canhViDu": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "khuon",
    "tieuDe",
    "nguon",
    "loi",
    "khop",
    "duLieu"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "khuon": {
     "const": "vi-du-cot-doc"
    },
    "tieuDe": {
     "$ref": "#/$defs/chu"
    },
    "nguon": {
     "$ref": "#/$defs/nguon"
    },
    "loi": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cau"
     }
    },
    "khop": {
     "type": "array",
     "items": {
