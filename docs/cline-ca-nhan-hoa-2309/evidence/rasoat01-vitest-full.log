[31m+         for (let i = 0; i < 6; i++) {[39m
[31m+           this.giong({ tre: T + 0.06 + i * 0.09, dang: 'sine', f0: 300 + i * 90,[39m
[31m+             f1: (300 + i * 90) * 2.2, to: 0.14, len: 0.006, giu: 0.02, tat: 0.14,[39m
