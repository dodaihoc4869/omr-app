[31m+   switch (kq.lyDo) {[39m
[31m+     case 'khong_co_ca':[39m
[31m+       return 'Không tìm thấy ca kiểm tra — kiểm tra lại mã ca.'[39m
[31m+     case 'da_xoa':[39m
[31m+       return 'Ca kiểm tra này đã bị thầy xoá.'[39m
[31m+     case 'da_dong':[39m
[31m+       return 'Ca kiểm tra này đã đóng.'[39m
[31m+     case 'sai_mat_khau_ca':[39m
[31m+       return 'Mật khẩu ca thi không đúng hoặc chưa nhập. Vui lòng nhập đúng mật khẩu ca thi.'[39m
[31m+     case 'dang_lam_may_khac':[39m
[31m+       return 'Số báo danh này đang làm bài ở máy khác. Nếu đúng là em, mở lại trên máy đã bắt đầu; nếu không, báo thầy ngay.'[39m
[31m+     case 'sai_may':[39m
[31m+       return 'Thầy cho em thi lại trên ĐÚNG máy em đã thi lần trước. Mở lại link trên máy đó, hoặc báo thầy.'[39m
[31m+     case 'da_nop':[39m
[31m+       return `Em đã nộp bài ca này${kq.nopLuc ? ` lúc ${gio(kq.nopLuc)}` : ''}${kq.lanThu && kq.lanThu > 1 ? ` (lần ${kq.lanThu})` : ''}. Muốn thi lại, xin thầy duyệt.`[39m
[31m+     case 'chua_mo':[39m
