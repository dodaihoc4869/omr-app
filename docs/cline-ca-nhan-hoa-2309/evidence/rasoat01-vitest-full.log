[31m+[39m
[31m+ export async function chiTietCa(scriptUrl: string, secret: string, maCa: string, xinKeyBank = false): Promise<ChiTietCa> {[39m
[31m+   // ĐƯỜNG NHANH — ĐỌC THẲNG MÁY CHỦ MỚI.[39m
[31m+   //[39m
[31m+   // Đo đường cũ: p50 **5,1 giây**. Thầy bấm vào một ca rồi ngồi nhìn năm giây,[39m
[31m+   // và giữa ca thì bấm nhiều lần.[39m
[31m+   //[39m
[31m+   // HAI CỔNG AN TOÀN, thiếu một cái là sai số liệu:[39m
[31m+   //   1. `xinKeyBank` ⇒ ĐI ĐƯỜNG CŨ. Ngân hàng CÓ ĐÁP ÁN chỉ nằm bên Apps[39m
[31m+   //      Script; R2 giữ bản KHÔNG đáp án (đúng thứ phục vụ công khai cho em).[39m
[31m+   //      Trả về thiếu `keyBank` là máy thầy chấm lại ra điểm sai.[39m
[31m+   //   2. `chiTietCaMoi` tự trả `null` khi ca chưa `dayDu` — ca chép sang từ[39m
[31m+   //      Sheet thiếu điểm, thiếu họ tên, thiếu dòng bị chặn.[39m
[31m+   try {[39m
[31m+     const chMoi = await layCauHinhMayChu()[39m
[31m+     const nhanh = await chiTietCaMoi(chMoi, secret, maCa)[39m
[31m+     // XIN NGÂN HÀNG CÓ ĐÁP ÁN mà gói nhanh chưa cất được nó ⇒ đi đường cũ.[39m
[31m+     //[39m
[31m+     // LỖI ĐÃ DÍNH, 19h45 ngày 11/09: bản trước đặt cả đường nhanh sau[39m
[31m+     // `if (!xinKeyBank)`. Màn Chi tiết ca gọi với `xinKeyBank = !banksCu`, mà[39m
[31m+     // điện thoại thầy không có sẵn ngân hàng của ca cũ nên cờ ấy LUÔN bật —[39m
[31m+     // đường nhanh bị bỏ qua vĩnh viễn trên điện thoại, dù D1 đủ dữ liệu.[39m
[31m+     // Nay lượt chữa lành cất ngân hàng lên R2 sau khoá riêng, nên đường nhanh[39m
[31m+     // phục vụ được cả nó; chỉ lùi khi thật sự chưa có.[39m
[31m+     if (nhanh && (!xinKeyBank || nhanh.keyBank)) return doiChiTietCaMoi(nhanh)[39m
[31m+   } catch {[39m
[31m+     // rơi xuống đường cũ[39m
[31m+   }[39m
[31m+[39m
[31m+   const r = await postJson(scriptUrl, { action: 'chiTietCa', secret, maCa, xinKeyBank }, HAN_GIAY_CHI_TIET_CA)[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không lấy được chi tiết ca')[39m
[31m+   const goiDR = moGoiDeRieng(r.goiDeRieng)[39m
[31m+[39m
[31m+   // TRỘN THÊM LƯỢT ĐANG NẰM Ở MÁY CHỦ MỚI.[39m
[31m+   //[39m
[31m+   // Ca chạy trên máy chủ mới thì lượt VÀO THI không tạo dòng bên Apps Script[39m
[31m+   // (chỉ lượt NỘP mới ghi cả hai nơi). Không trộn thì giữa ca thầy mở màn Chi[39m
[31m+   // tiết ca ra là thấy TRỐNG: không biết ai đã vào, ai đang làm, và không có gì[39m
[31m+   // để bấm mở khoá hay cho thi lại.[39m
[31m+   //[39m
[31m+   // DÒNG BÊN SHEET THẮNG khi trùng `sbd|lanThu`: bên ấy có điểm, có họ tên, có[39m
[31m+   // ghi chú — tức là bản đầy đủ hơn. Bên máy chủ mới chỉ bù những em Sheet chưa[39m
[31m+   // có.[39m
[31m+   const luotSheet = (r.luot as LuotThiRow[]).map((l) => ({ ...l, sbd: String(l.sbd), lanThu: Number(l.lanThu) || 1 }))[39m
[31m+   let luotGop = luotSheet[39m
[31m+   try {[39m
[31m+     const chMoi = await layCauHinhMayChu()[39m
[31m+     const themMoi = await luotCuaCaMoi(chMoi, secret, maCa)[39m
[31m+     if (themMoi && themMoi.length > 0) {[39m
[31m+       const daCo = new Set(luotSheet.map((l) => `${l.sbd}|${l.lanThu}`))[39m
[31m+       const bu = themMoi[39m
[31m+         .map((l) => l as unknown as LuotThiRow)[39m
[31m+         .filter((l) => !daCo.has(`${String(l.sbd)}|${Number(l.lanThu) || 1}`))[39m
[31m+       if (bu.length > 0) luotGop = [...luotSheet, ...bu][39m
[31m+     }[39m
[31m+   } catch {[39m
[31m+     // không có gì để trộn — giữ nguyên danh sách cũ[39m
[31m+   }[39m
[31m+[39m
[31m+   // TỰ CHỮA LÀNH — gửi gói vừa đọc được sang máy chủ mới rồi đặt cờ đủ dữ liệu.[39m
[31m+   //[39m
[31m+   // Đo 19h05 ngày 11/09, ngay sau khi phát hành đợt 5D: 88/88 ca `sinh_tai_d1[39m
[31m+   // = 0`, 311 lượt không dòng nào có điểm hay họ tên. Cờ ấy chỉ đặt cho ca mở[39m
[31m+   // TỪ NAY, nên đường nhanh chưa từng chạy một lần — thầy bấm chi tiết ca vẫn[39m
[31m+   // mất 7 giây.[39m
[31m+   //[39m
[31m+   // Không chờ, không báo lỗi: đây là đường tắt cho LẦN SAU. Worker tự từ chối[39m
[31m+   // ca đang mở, nên không có đường nào chép đè lên bài em đang làm.[39m
[31m+   void (async () => {[39m
[31m+     try {[39m
[31m+       const chMoi = await layCauHinhMayChu()[39m
[31m+       await napDayDuCaMoi([39m
[31m+         chMoi,[39m
[31m+         secret,[39m
[31m+         maCa,[39m
[31m+         luotSheet as unknown as Record<string, unknown>[],[39m
[31m+         (r.keyBank as KeyBank) ?? undefined,[39m
[31m+       )[39m
[31m+     } catch {[39m
[31m+       // lần sau đọc lại vẫn có cơ hội chữa[39m
[31m+     }[39m
[31m+   })()[39m
[31m+[39m
[31m+   return {[39m
[31m+     ca: { ...r.ca, maCa: String(r.ca.maCa), lop: String(r.ca.lop ?? '') },[39m
[31m+     luot: luotGop,[39m
[31m+     keyBank: (r.keyBank as KeyBank) ?? null,[39m
[31m+     // Máy chủ cũ chưa có trường này ⇒ mảng rỗng, màn hình không vỡ.[39m
[31m+     biChan: Array.isArray(r.biChan)[39m
[31m+       ? (r.biChan as Record<string, unknown>[]).map((b) => ({[39m
[31m+           luc: String(b.luc ?? ''),[39m
[31m+           sbd: String(b.sbd ?? ''),[39m
[31m+           hoTenGoi: String(b.hoTenGoi ?? ''),[39m
[31m+           namSinhGoi: String(b.namSinhGoi ?? ''),[39m
[31m+           hoTenDs: String(b.hoTenDs ?? ''),[39m
[31m+           namSinhDs: String(b.namSinhDs ?? ''),[39m
[31m+           lyDo: String(b.lyDo ?? ''),[39m
[31m+         }))[39m
[31m+       : [],[39m
[31m+     dsCho: Array.isArray(r.dsCho)[39m
[31m+       ? (r.dsCho as Record<string, unknown>[]).map((x) => ({ sbd: chuoi(x.sbd), hoTen: chuoi(x.hoTen), vaoLuc: chuoi(x.vaoLuc) })).filter((x) => x.sbd)[39m
[31m+       : [],[39m
[31m+     // Ưu tiên gói riêng (luôn có, mọi máy); `keyBank.boTheoEm` là đường cũ.[39m
[31m+     boTheoEmCa: goiDR.bo ?? (r.keyBank as { boTheoEm?: Record<string, string[]> } | null | undefined)?.boTheoEm ?? undefined,[39m
[31m+     lapTheoEm: goiDR.lap,[39m
[31m+     demSaiTheoEm: goiDR.dem,[39m
[31m+     bienBanDeRieng: goiDR.bb,[39m
[31m+   }[39m
[31m+ }[39m
