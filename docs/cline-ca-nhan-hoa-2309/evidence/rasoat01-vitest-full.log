[31m+  * thầy nhìn thấy mới đúng là cái nằm trong ô Sheet. */[39m
[31m+ export async function doiTenCa(scriptUrl: string, secret: string, maCa: string, tenCa: string): Promise<{ tenCa: string }> {[39m
[31m+   const r = await postJson(scriptUrl, { action: 'doiTenCa', secret, maCa, tenCa: chuanTenCa(tenCa) })[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không đổi được tên ca')[39m
[31m+   await soiCaSangMayChuMoi(secret, maCa, { tenCa: String((r as { tenCa?: string }).tenCa ?? chuanTenCa(tenCa)) })[39m
[31m+   // Danh sách ca vừa đổi — bỏ đệm để lượt hỏi tiếp theo thấy ngay.[39m
[31m+   xoaBoDemCa()[39m
