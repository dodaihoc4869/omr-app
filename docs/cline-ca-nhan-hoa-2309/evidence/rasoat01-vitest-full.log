[31m+   if (!daLenMayChuMoi) throw new Error('Không đẩy được ca lên máy chủ — kiểm tra địa chỉ máy chủ và mã bí mật rồi mở lại')[39m
[31m+[39m
[31m+   xoaBoDemCa()[39m
[31m+   return { batDau: batDauISO, hetHanVao: hetHanISO }[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Cập nhật bản CÓ đáp án + lời giải của một ca ĐÃ MỞ (thầy chốt đáp án, hoặc[39m
[31m+  * lời giải mới về máy) — học sinh xem lại thấy bản mới. Cần mã bí mật. */[39m
