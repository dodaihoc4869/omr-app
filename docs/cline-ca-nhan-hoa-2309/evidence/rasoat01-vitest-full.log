[31m+[39m
[31m+ // ---------------------------------------------------------------------------[39m
[31m+ // GỘP LƯỢT GỌI `danhSachCa` — lệnh bị gọi nhiều nhất trong app[39m
[31m+ // ---------------------------------------------------------------------------[39m
[31m+ //[39m
[31m+ // 11 chỗ trong app gọi lệnh này, và thầy đổi màn là gọi lại. Đo 10/09 tối, lúc[39m
[31m+ // máy chủ RẢNH: mỗi lượt 3,1 – 4,9 giây. Mở màn Ca thi rồi sang màn Học sinh[39m
[31m+ // rồi quay lại là ba lượt gọi cho cùng một danh sách 10 ca — mười giây ngồi[39m
[31m+ // nhìn vòng xoay, trong khi danh sách ấy không đổi.[39m
[31m+ //[39m
[31m+ // HAI LỚP, cả hai đều nhỏ và đều an toàn:[39m
[31m+ //[39m
[31m+ //   1. GỘP LƯỢT ĐANG BAY (single-flight). Hai màn cùng hỏi một lúc thì đi CHUNG[39m
[31m+ //      một lượt gọi. Không có lớp này thì màn Ca thi và thanh điều hướng bắn[39m
[31m+ //      hai lượt song song cho cùng một câu hỏi.[39m
[31m+ //   2. ĐỆM NGẮN 8 GIÂY. Đủ để nuốt trọn một chuỗi đổi màn, và ngắn hơn nhịp[39m
[31m+ //      làm mới của màn Theo dõi nên thầy không bao giờ nhìn phải số cũ quá một[39m
[31m+ //      nhịp.[39m
[31m+ //[39m
[31m+ // VÌ SAO 8 GIÂY LÀ AN TOÀN: danh sách ca đổi khi thầy TỰ mở/khoá/xoá ca — mà[39m
[31m+ // những việc đó đều đi qua `xoaBoDemCa()` ngay bên dưới, nên bấm xong là thấy[39m
[31m+ // ngay, không phải chờ hết đệm. Đệm chỉ chặn những lượt hỏi LẶP trong lúc không[39m
[31m+ // có gì thay đổi.[39m
[31m+ const DEM_CA_MS = 8000[39m
[31m+[39m
[31m+ interface DemCa {[39m
[31m+   luc: number[39m
[31m+   ds: CaTomTat[][39m
[31m+ }[39m
[31m+ const demCa = new Map<string, DemCa>()[39m
[31m+ const dangBay = new Map<string, Promise<CaTomTat[]>>()[39m
[31m+[39m
[31m+ /** XOÁ ĐỆM. Gọi ngay sau mọi lệnh làm đổi danh sách ca — mở ca, khoá ca, đổi[39m
[31m+  * tên, xoá, khôi phục. Thà hỏi lại một lượt còn hơn để thầy nhìn số cũ. */[39m
[31m+ export function xoaBoDemCa(): void {[39m
[31m+   demCa.clear()[39m
[31m+   dangBay.clear()[39m
[31m+ }[39m
[31m+[39m
[31m+ /** daXoa = true → lấy các ca ĐÃ XOÁ (thùng rác) thay vì ca đang dùng. */[39m
[31m+ export async function danhSachCa(scriptUrl: string, secret: string, daXoa = false): Promise<CaTomTat[]> {[39m
[31m+   const khoa = `${scriptUrl}|${daXoa}`[39m
[31m+   const co = demCa.get(khoa)[39m
[31m+   if (co && Date.now() - co.luc < DEM_CA_MS) return co.ds[39m
[31m+   const bay = dangBay.get(khoa)[39m
[31m+   if (bay) return bay[39m
[31m+   const p = danhSachCaThat(scriptUrl, secret, daXoa)[39m
[31m+     .then((ds) => {[39m
[31m+       demCa.set(khoa, { luc: Date.now(), ds })[39m
[31m+       return ds[39m
[31m+     })[39m
[31m+     .finally(() => {[39m
[31m+       dangBay.delete(khoa)[39m
[31m+     })[39m
[31m+   dangBay.set(khoa, p)[39m
[31m+   return p[39m
[31m+ }[39m
[31m+[39m
[31m+ async function danhSachCaThat(scriptUrl: string, secret: string, daXoa: boolean, chiDuongCu = false): Promise<CaTomTat[]> {[39m
[31m+   // MÁY CHỦ MỚI TRƯỚC — nhưng CHỈ khi trên D1 có dấu `ca_day_du`. Chưa chuyển[39m
[31m+   // xong dữ liệu thì `danhSachCaMoi` trả `null` và ta đi đường cũ, vì màn Ca[39m
[31m+   // thi thiếu ca hoặc đếm sai số em còn tệ hơn màn Ca thi chậm.[39m
[31m+   // Xem `src/lib/man-ca-may-chu-moi.ts`.[39m
[31m+   // `chiDuongCu` = lượt CHUYỂN DỮ LIỆU. Nó phải đọc NGUỒN SỰ THẬT là Apps[39m
[31m+   // Script; đọc D1 rồi ghi lại vào D1 là tự soi gương rồi bảo mình khớp.[39m
[31m+   try {[39m
[31m+     const chMoi = chiDuongCu ? null : await layCauHinhMayChu()[39m
[31m+     const rMoi = chMoi ? await danhSachCaMoi(chMoi, secret, daXoa) : null[39m
[31m+     if (rMoi) return chuanCaTomTat(rMoi.items)[39m
[31m+   } catch {[39m
[31m+     // máy chủ mới hỏng thì im lặng đi đường cũ — đây không phải luồng chính[39m
[31m+   }[39m
[31m+   const r = await postJson(scriptUrl, { action: 'danhSachCa', secret, daXoa })[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không lấy được danh sách ca')[39m
[31m+   return chuanCaTomTat(r.items as CaTomTat[])[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Chuẩn hoá một danh sách ca, dùng chung cho CẢ HAI máy chủ — hai đường trả về[39m
[31m+  * cùng một dáng thì màn hình không phải biết mình đang đọc ở đâu. */[39m
[31m+ function chuanCaTomTat(items: unknown): CaTomTat[] {[39m
[31m+   return (items as CaTomTat[]).map((c) => ({[39m
[31m+     ...c,[39m
[31m+     maCa: String(c.maCa),[39m
[31m+     lop: String(c.lop ?? ''),[39m
[31m+     tenCa: String(c.tenCa ?? ''),[39m
[31m+     loai: c.loai === 'baitap' ? 'baitap' : 'thi',[39m
[31m+     hanNop: String(c.hanNop ?? ''),[39m
[31m+     // Máy chủ chưa cập nhật (.gs bản cũ) thì KHÔNG có trường này — coi như bật,[39m
[31m+     // để danh sách ca ở màn Gọi lên bảng không rỗng sau khi cập nhật app.[39m
[31m+     lenBang: c.lenBang !== false,[39m
[31m+   }))[39m
[31m+ }[39m
[31m+[39m
[31m+ export interface LuotThiRow {[39m
[31m+   sbd: string[39m
[31m+   hoTen: string[39m
[31m+   lanThu: number[39m
[31m+   trangThai: TrangThaiLuot[39m
[31m+   vaoLuc: string[39m
[31m+   hetGioLuc: string[39m
[31m+   nopLuc: string[39m
[31m+   soLanRoiMan: number[39m
[31m+   tongGiayRoiMan: number[39m
[31m+   diemI: number | null[39m
[31m+   diemII: number | null[39m
[31m+   diemIII: number | null[39m
[31m+   tong: number | null[39m
[31m+   duyetBoi: string[39m
[31m+   duyetLuc: string[39m
[31m+   ghiChu: string[39m
[31m+   dapAn: AnswerRecord | null[39m
[31m+   integrity: IntegrityLog | null[39m
[31m+   giayCau: Record<string, number> | null[39m
[31m+   /** Lượt này đang KHOÁ VÀO ĐÚNG MỘT MÁY (`id_thiet_bi` có giá trị) — máy chủ chỉ báo có/không, không lộ mã máy. Thiếu (máy chủ chưa trả) ⇒ chưa biết. */[39m
[31m+   khoaMay?: boolean[39m
[31m+ }[39m
[31m+[39m
[31m+ export interface ChiTietCa {[39m
[31m+   ca: Omit<CaTomTat, 'daVao' | 'daNop' | 'canhBao'> & { danhSachMoi: string | string[]; nguoiTao: string; nguongLan?: number; nguongGiay?: number }[39m
[31m+   luot: LuotThiRow[][39m
[31m+   /** Ngân hàng CÓ đáp án của ca — chỉ trả khi gọi với `xinKeyBank`, để máy thầy[39m
[31m+    * chưa có bản đề (ca mở ở máy khác) vẫn chấm lại và xuất phiếu được. */[39m
[31m+   keyBank?: KeyBank | null[39m
[31m+   /** Những lượt bị cổng danh sách CHẶN, mới nhất trước. Máy chủ cố ý không nói[39m
[31m+    * cho em biết sai ô nào, nhưng thầy đứng trong phòng thì phải thấy. */[39m
[31m+   biChan?: LuotBiChan[][39m
[31m+   /** EM ĐANG ĐỨNG Ở PHÒNG CHỜ, vào trước đứng trước.[39m
[31m+    *[39m
[31m+    * Cổng phòng chờ KHÔNG tạo lượt thi, nên đây là nguồn duy nhất trả lời "ai[39m
[31m+    * đang có mặt" — và chế độ đề riêng từng em rút bộ câu đúng theo danh sách[39m
[31m+    * này lúc thầy bấm Bắt đầu (thầy chốt 08/09). */[39m
[31m+   dsCho?: { sbd: string; hoTen: string; vaoLuc: string }[][39m
[31m+   /** sbd → qid CÂU HỎI LẠI của em đó, đọc từ chính ô máy chủ đã ghi lúc bấm[39m
[31m+    * Bắt đầu.[39m
[31m+    *[39m
[31m+    * Vì sao cần: bản đồ này được cất ở IndexedDB của MÁY BẤM BẮT ĐẦU. Thầy bấm[39m
[31m+    * ở điện thoại rồi mở ca trên máy tính là máy tính không có gì, và màn Ca thi[39m
[31m+    * im lặng — đúng lỗi thầy gặp 08/09. Lệnh này đã đòi mã bí mật nên trả cả[39m
[31m+    * bản đồ lớp ở đây không mở thêm quyền cho ai. */[39m
[31m+   /** BỘ CÂU TỪNG EM của ca, đọc từ máy chủ. Đây là bản đồ dùng để CHẤM.[39m
[31m+    *[39m
[31m+    * Thầy bắt được 08/09: màn Ca thi chỉ đọc bản đồ cất ở IndexedDB của đúng cái[39m
[31m+    * máy đã bấm Bắt đầu. Mở ca ở máy khác là chấm lại bằng luật hash ⇒ khối "câu[39m
[31m+    * em sai buổi trước" đếm ra 0 dù máy chủ có đủ 8 câu, và điểm hiện trên bảng[39m
[31m+    * cũng là điểm của một bộ câu khác. */[39m
[31m+   boTheoEmCa?: Record<string, string[]>[39m
[31m+   lapTheoEm?: Record<string, string[]>[39m
[31m+   /** sbd → qid → số lần sai trước ca này, đọc từ máy chủ. */[39m
[31m+   demSaiTheoEm?: Record<string, Record<string, number>>[39m
[31m+   /** Biên bản lúc rút đề riêng, đọc từ máy chủ. */[39m
[31m+   bienBanDeRieng?: Record<string, unknown> | null[39m
[31m+   /** Tổng số phút thầy đã "Thêm phút" cho ca (máy chủ có lệnh /ca/them-phut mới trả; vắng = 0 hoặc máy chủ cũ). */[39m
[31m+   themPhutTong?: number[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Một lượt bị cổng vào thi chặn. `lyDo` do máy chủ đặt:[39m
[31m+  * `khong_co_sbd` số báo danh không có trong danh sách lớp ·[39m
[31m+  * `lech_ho_ten` họ tên gõ khác danh sách · `lech_nam_sinh` năm sinh gõ khác. */[39m
[31m+ export interface LuotBiChan {[39m
[31m+   luc: string[39m
[31m+   sbd: string[39m
[31m+   hoTenGoi: string[39m
[31m+   namSinhGoi: string[39m
