[31m+       hanNop: c.hanNop,[39m
[31m+       lenBang: c.lenBang !== false,[39m
[31m+       phongCho: c.phongCho === true,[39m
[31m+       batDauThiLuc: c.batDauThiLuc ?? '',[39m
[31m+       xoaLuc: c.xoaLuc ?? '',[39m
