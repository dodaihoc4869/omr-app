[31m+             loc: 'lowpass', f0: 5200, f1: 400, q: 0.9, vang: 0.4 })[39m
[31m+           this.giong({ tre: tre + 0.01, dang: 'square', f0: 520 + i * 40, f1: 300, to: 0.07,[39m
[31m+             giu: 0.02, tat: 0.2, loc: 'bandpass', fLoc: 2400, qLoc: 8, vang: 0.5 })[39m
[31m+         }[39m
[31m+         break[39m
[31m+       case 'lua':[39m
