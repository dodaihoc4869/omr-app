[31m+   /** Số báo danh không có trong danh sách lớp, hoặc dòng danh sách bỏ trống tên. */[39m
[31m+   khongCo: string[][39m
[31m+   giuNguyen: number[39m
[31m+ }[39m
[31m+[39m
[31m+ /** ĐỒNG BỘ HỌ TÊN TỪ DANH SÁCH LỚP VÀO MỘT CA (thầy báo 07/09).[39m
[31m+  *[39m
[31m+  * Em vào thi chỉ gõ số báo danh nên cột HoTen của lượt bỏ trống, và phiếu gửi[39m
