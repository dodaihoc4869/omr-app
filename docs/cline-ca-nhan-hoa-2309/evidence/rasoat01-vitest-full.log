[31m+ /** Đang toàn màn hình: đã thêm vào màn hình chính (standalone) HOẶC Fullscreen API đang bật. */[39m
[31m+ function dangToanManHinh(): boolean {[39m
[31m+   if (typeof document === 'undefined') return true[39m
[31m+   const nav = navigator as Navigator & { standalone?: boolean }[39m
[31m+   if (nav.standalone || window.matchMedia('(display-mode: standalone)').matches || window.matchMedia('(display-mode: fullscreen)').matches) return true[39m
[31m+   const d = document as Document & { webkitFullscreenElement?: Element | null }[39m
[31m+   return !!(document.fullscreenElement || d.webkitFullscreenElement)[39m
[31m+ }[39m
[31m+ function coTheBatToanManHinh(): boolean {[39m
[31m+   if (typeof document === 'undefined') return false[39m
[31m+   const el = document.documentElement as HTMLElement & { webkitRequestFullscreen?: () => Promise<void> | void }[39m
[31m+   return typeof el.requestFullscreen === 'function' || typeof el.webkitRequestFullscreen === 'function'[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Đang mở trong TRÌNH DUYỆT CỦA MỘT ỨNG DỤNG KHÁC (Zalo, Messenger, Facebook)?[39m
[31m+  *[39m
[31m+  * VÌ SAO CẦN BIẾT (thầy báo 17:34 ngày 09/09, kèm ảnh: iPhone kẹt ở màn vào thi,[39m
[31m+  * góc trái ghi "◄ Zalo"). Em nhận link qua Zalo rồi bấm thẳng vào đó, nên trang[39m
[31m+  * chạy trong trình duyệt NHÚNG của Zalo. Ở đó:[39m
[31m+  *   · không phải standalone ⇒ `dangToanManHinh()` sai;[39m
[31m+  *   · iOS không cho `requestFullscreen` trên phần tử ⇒ không có nút để bật;[39m
[31m+  *   · và Zalo KHÔNG có mục "Thêm vào Màn hình chính" ⇒ làm đúng theo dòng chữ[39m
[31m+  *     app đang hiện cũng không ra.[39m
[31m+  * Ba cái cộng lại là em không có đường nào vào thi. Dòng nhắc cũ chỉ vào một[39m
[31m+  * việc KHÔNG LÀM ĐƯỢC ở đó — nên phải nói đúng việc: mở bằng Safari trước.[39m
[31m+  *[39m
[31m+  * Nhận dạng theo user agent là phỏng đoán, không chắc chắn. Nên nó chỉ đổi CHỮ[39m
[31m+  * hướng dẫn, không đổi quyền vào thi của ai. */[39m
[31m+ function laTrinhDuyetTrongUngDung(nav: Navigator = navigator): boolean {[39m
[31m+   const ua = String(nav.userAgent || '')[39m
[31m+   return /\b(Zalo|FBAN|FBAV|FB_IAB|Instagram|Line\/|MicroMessenger|TikTok)\b/i.test(ua)[39m
[31m+ }[39m
[31m+[39m
[31m+ /** iPhone/iPad — nơi Apple không cho trang tự vào toàn màn hình. */[39m
[31m+ function laIOS(nav: Navigator = navigator): boolean {[39m
[31m+   const ua = String(nav.userAgent || '')[39m
[31m+   if (/iPhone|iPad|iPod/i.test(ua)) return true[39m
[31m+   // iPadOS 13+ khai là Macintosh; phân biệt bằng màn hình cảm ứng.[39m
[31m+   return /Macintosh/i.test(ua) && (nav.maxTouchPoints ?? 0) > 1[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Chữ hướng dẫn ĐÚNG VIỆC LÀM ĐƯỢC ở đúng chỗ em đang đứng. */[39m
[31m+ export function loiKhuyenToanManHinh(coBatDuoc: boolean, trongUngDung: boolean, ios: boolean): string {[39m
[31m+   if (coBatDuoc) return 'Bấm nút dưới để bật toàn màn hình, bài làm đỡ bị che.'[39m
[31m+   if (trongUngDung) return 'Em đang mở trong ứng dụng khác. Bấm ⋯ rồi chọn "Mở trong Safari", sau đó bấm Chia sẻ → "Thêm vào Màn hình chính" và mở app từ biểu tượng đó.'[39m
[31m+   if (ios) return 'Bấm nút Chia sẻ ở thanh dưới rồi chọn "Thêm vào Màn hình chính", sau đó mở app từ biểu tượng vừa hiện.'[39m
[31m+   return 'Thêm app vào màn hình chính (hướng dẫn ở trên) rồi mở lại từ đó.'[39m
[31m+ }[39m
[31m+ async function batToanManHinh(): Promise<void> {[39m
[31m+   const el = document.documentElement as HTMLElement & { webkitRequestFullscreen?: () => Promise<void> | void }[39m
[31m+   try {[39m
[31m+     if (typeof el.requestFullscreen === 'function') await el.requestFullscreen({ navigationUI: 'hide' } as FullscreenOptions)[39m
[31m+     else if (typeof el.webkitRequestFullscreen === 'function') await el.webkitRequestFullscreen()[39m
[31m+   } catch {[39m
[31m+     // trình duyệt từ chối (vd iOS Safari) — ô nhắc phía trên đã hướng dẫn thêm vào màn hình chính[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
[31m+ function formatClock(totalSeconds: number): string {[39m
[31m+   const s = Math.max(0, Math.floor(totalSeconds))[39m
[31m+   const m = Math.floor(s / 60)[39m
[31m+   const sec = s % 60[39m
[31m+   return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`[39m
[31m+ }[39m
