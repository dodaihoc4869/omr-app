[31m+               if (!khoaDuocViCuaSoNoi(camUngMay)) return // che thì có, khoá thì không[39m
[31m+               if (!conAnHan() && coKhoa(muc, 'cua_so_noi', soLanNoi)) khoaVi('cua_so_noi', 'kênh 2')[39m
