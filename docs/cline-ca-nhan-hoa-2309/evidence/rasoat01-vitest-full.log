[31m+ }[39m
[31m+[39m
[31m+ /** ĐỌC SỐ CỦA GOOGLE SHEET CHO BẢNG ĐỐI CHIẾU.[39m
[31m+  *[39m
[31m+  * CHỈ ĐỌC, không ghi gì. Đi bằng `chiDuongCu = true` để chắc chắn lấy số của[39m
[31m+  * Apps Script chứ không vô tình đọc lại chính máy chủ mới rồi tự so với mình.[39m
[31m+  * Đó đúng là cái bẫy đã làm tôi mù cả ngày 11/09: đo bằng công cụ do chính máy[39m
[31m+  * chủ phục vụ thì lúc nào cũng đẹp. */[39m
[31m+ export async function laySoSheet([39m
[31m+   scriptUrl: string,[39m
[31m+   secret: string,[39m
[31m+ ): Promise<{ soCa: number; soCaChuaXoa: number; soLuot: number; soDanhSach: number | null }> {[39m
[31m+   const dsCon = await danhSachCaThat(scriptUrl, secret, false, true)[39m
[31m+   const dsXoa = await danhSachCaThat(scriptUrl, secret, true, true)[39m
[31m+   // Số LƯỢT: cộng `daVao` của mọi ca. Apps Script đã đếm sẵn trong chính lượt[39m
[31m+   // `danhSachCa`, nên không phải mở từng ca — đúng bài học 15h46 ngày 11/09,[39m
[31m+   // lượt chuyển đọc chi tiết 83 ca đã chết ở ca thứ 6.[39m
[31m+   const congVao = (ds: CaTomTat[]): number => ds.reduce((t, c) => t + (Number(c.daVao) || 0), 0)[39m
[31m+   return {[39m
[31m+     soCa: dsCon.length + dsXoa.length,[39m
[31m+     soCaChuaXoa: dsCon.length,[39m
[31m+     soLuot: congVao(dsCon) + congVao(dsXoa),[39m
[31m+     // Apps Script không có lệnh đếm danh sách lớp ⇒ nói thẳng là không đối[39m
[31m+     // chiếu được, không bịa số 0.[39m
[31m+     soDanhSach: null,[39m
[31m+   }[39m
[31m+ }[39m
