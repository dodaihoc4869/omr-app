[31m+     60,[39m
[31m+   )[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không lấy được câu khắc phục')[39m
[31m+   const items = Array.isArray(r.items) ? r.items : [][39m
[31m+   return {[39m
[31m+     nguon: items.map((x: { ma_de?: string }) => ({ maDe: String(x?.ma_de || ''), json: x })),[39m
[31m+     soCau: Number(r.soCau) || 0,[39m
[31m+     soChon: Number(r.soChon) || 0,[39m
[31m+     thuTu: Array.isArray(r.thuTu) ? r.thuTu.map((x: unknown) => String(x)) : [],[39m
[31m+     catBotViNang: r.catBotViNang === true,[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
[31m+ /** MÁY EM GHI GÓI CÂU KHẮC PHỤC vừa nhận, để nộp được ngay sau khi thi.[39m
[31m+  *[39m
[31m+  * Báo cáo em xem ngay sau khi nộp do chính máy em dựng tại chỗ — không có mã[39m
