[31m+ /** Học sinh tự động gửi lên định kỳ trong lúc làm bài + ngay mỗi lần rời màn[39m
[31m+  * hình, để phụ huynh xem gần-thời-gian-thực và nhận cảnh báo rời màn hình[39m
[31m+  * sớm nhất có thể (không phải push thật, phụ huynh tự poll lại). */[39m
[31m+ export async function pushExamStatus([39m
[31m+   scriptUrl: string,[39m
[31m+   status: {[39m
[31m+     sbd: string[39m
[31m+     maCa: string[39m
[31m+     lop: string[39m
[31m+     dangLam: boolean[39m
[31m+     batDauLuc: string[39m
[31m+     daLamCauHoi: number[39m
[31m+     tongCauHoi: number[39m
[31m+     soLanRoiApp: number[39m
[31m+     blocked: boolean[39m
[31m+   },[39m
[31m+ ): Promise<boolean> {[39m
[31m+   try {[39m
[31m+     // MÁY CHỦ MỚI TRƯỚC — 270 lượt một em một ca, lệnh dày nhất trong toàn bộ hệ.[39m
[31m+     const chMoi = await layCauHinhMayChu()[39m
[31m+     const rMoi = await trangThaiMoi(chMoi, status)[39m
[31m+     if (rMoi !== null) return rMoi[39m
[31m+[39m
[31m+     const r = await postJson(scriptUrl, { action: 'examStatus', ...status })[39m
[31m+     return !!r?.ok[39m
[31m+   } catch {[39m
[31m+     // Cập nhật trạng thái theo dõi không phải luồng chính — mất mạng thì bỏ[39m
[31m+     // qua, không chặn học sinh làm bài, lần đẩy tiếp theo sẽ tự bù.[39m
[31m+     //[39m
[31m+     // TRẢ VỀ FALSE, KHÔNG PHẢI VOID: chỗ gọi dùng giá trị này để biết có được[39m
[31m+     // phép ghi nhớ "đã gửi rồi" hay không. Nuốt lỗi rồi im lặng báo thành công[39m
[31m+     // là cách chắc chắn nhất để một nhịp rớt mạng biến thành mất dữ liệu.[39m
[31m+     return false[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
