[31m+     document.addEventListener('webkitfullscreenchange', onFs)[39m
[31m+     return () => {[39m
[31m+       document.removeEventListener('visibilitychange', onVis)[39m
[31m+       window.removeEventListener('blur', onBlur)[39m
[31m+       window.removeEventListener('focus', onFocus)[39m
[31m+       document.removeEventListener('fullscreenchange', onFs)[39m
[31m+       document.removeEventListener('webkitfullscreenchange', onFs)[39m
[31m+       if (henBlur) clearTimeout(henBlur)[39m
[31m+       if (henAn) clearTimeout(henAn)[39m
[31m+       if (roiLauTimerRef.current) clearTimeout(roiLauTimerRef.current)[39m
[31m+       if (canhBaoTimerRef.current) clearTimeout(canhBaoTimerRef.current)[39m
[31m+     }[39m
[31m+     // eslint-disable-next-line react-hooks/exhaustive-deps[39m
[31m+   }, [phase])[39m
[31m+[39m
[31m+   // ==========================================================================[39m
[31m+   // TÍN HIỆU MỚI — BAOMATCATHI.md mục 3. MỘT LẦN LÀ KHOÁ.[39m
[31m+   // ==========================================================================[39m
[31m+   // Effect RIÊNG, không đụng một dòng nào của luật đếm rời app phía trên.[39m
[31m+   //[39m
[31m+   // Bốn tín hiệu: thoát toàn màn hình · thu nhỏ hoặc chia đôi màn · cửa sổ nổi[39m
[31m+   // đè lên · dấu vết chụp màn hình. Ba tấm đệm chống oan vẫn còn nguyên: ân hạn[39m
[31m+   // 3 giây đầu, nhịp chờ 900 ms trước khi kết luận cửa sổ nổi, và màn khoá bảo[39m
[31m+   // em giơ tay gọi thầy (thầy mở khoá một chạm ở Chi tiết ca).[39m
[31m+   useEffect(() => {[39m
[31m+     if (phase !== 'exam') return[39m
[31m+     // Mức ngặt của ca. Ca mở trước bản này chưa có cột MucNgat trên máy chủ ⇒[39m
[31m+     // rơi về Bình thường, đúng hành vi cũ, không đổi điểm ca đã gửi phụ huynh.[39m
[31m+     const muc = MUC_NGAT_MAC_DINH[39m
[31m+     // Máy cảm ứng (điện thoại, máy tính bảng) không có tín hiệu tiêu điểm và[39m
[31m+     // toàn màn hình đáng tin — xem `khoaDuocViCuaSoNoi` và `onFs`.[39m
[31m+     const camUngMay = laMayCamUng()[39m
[31m+     const vaoLuc = performance.now()[39m
[31m+     const phieu: PhieuKenh[] = [][39m
[31m+     let coMan: TrangThaiCoMan = { moc: window.innerWidth * window.innerHeight, nhoTu: null }[39m
[31m+     let raTu: number | null = null[39m
[31m+     let soLanNoi = 0[39m
[31m+     let daKhoa = false[39m
[31m+     let henNoi: number | undefined[39m
[31m+[39m
[31m+     const conAnHan = () => performance.now() - vaoLuc < MS_AN_HAN_VAO_BAI[39m
[31m+[39m
[31m+     /** Che đề NGAY, không đợi phân loại. Việc che ở nhịp 0; ba nhịp sau chỉ[39m
[31m+      * hoãn việc PHÂN LOẠI. */[39m
[31m+     const che = (ly: string) => setLyDoChe(ly)[39m
[31m+     const boChe = () => setLyDoChe(null)[39m
[31m+[39m
[31m+     const khoaVi = (lyDo: LyDoKhoaMoi, kenhBao?: string) => {[39m
[31m+       if (daKhoa) return[39m
