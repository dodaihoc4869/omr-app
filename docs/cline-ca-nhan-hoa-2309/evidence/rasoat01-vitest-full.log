[31m+ }[39m
[31m+[39m
[31m+ /** Xoá MỀM nhiều ca một lượt. Gọi tuần tự (Apps Script ghi Sheet, chạy song song[39m
[31m+  * dễ chèn nhau); mỗi ca tự lấy mã của nó làm xacNhan vì thầy đã tích chọn ca đó[39m
[31m+  * trên màn hình. Một ca lỗi KHÔNG chặn các ca còn lại. */[39m
[31m+ export async function xoaNhieuCa(scriptUrl: string, secret: string, dsMaCa: string[]): Promise<KetQuaXoaNhieu> {[39m
