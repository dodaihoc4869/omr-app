[31m+   _scriptUrl: string,[39m
[31m+   maCa: string,[39m
[31m+   lop: string,[39m
[31m+   thoiGianPhut: number,[39m
[31m+   bank: PublicExamBank,[39m
[31m+   congBoDiem: CongBoDiem = 'khong',[39m
[31m+   keyBank?: KeyBank,[39m
[31m+   moc: MocThoiGianCa = {},[39m
