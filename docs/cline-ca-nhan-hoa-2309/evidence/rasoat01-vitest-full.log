[31m+         // SOLAR FLARE ERUPTION — bùng nổ hào quang nhiệt nhôm:[39m
[31m+         this.giong({ tre: T, dang: 'sawtooth', f0: 88, fGiua: 140, f1: 62, to: 0.42,[39m
[31m+           len: 0.05, giu: 0.5, tat: 0.6, rung: 0.06, nhipRung: 11,[39m
[31m+           loc: 'lowpass', fLoc: 900, fLoc1: 260, qLoc: 3, lech: 16, vang: 0.45 })[39m
[31m+         this.on({ tre: T, to: 0.34, len: 0.06, giu: 0.44, tat: 0.66,[39m
[31m+           loc: 'bandpass', f0: 1500, f1: 400, q: 0.7, vang: 0.55 })[39m
[31m+         for (let i = 0; i < 9; i++) {[39m
[31m+           this.on({ tre: T + 0.05 + i * 0.07 + Math.random() * 0.03, to: 0.12,[39m
[31m+             giu: 0.004, tat: 0.09, loc: 'bandpass', f0: 900 + Math.random() * 3200, q: 4, vang: 0.4 })[39m
[31m+         }[39m
[31m+         break[39m
[31m+       case 'ductin':[39m
[31m+       case 'dien':[39m
[31m+         // LAW OF CONSERVATION REALM — Kim Cương Giới Bất Hoại:[39m
[31m+         this.giong({ tre: T, dang: 'sawtooth', f0: 104, fGiua: 168, f1: 96, to: 0.44,[39m
[31m+           len: 0.06, giu: 0.42, tat: 0.55, rung: 0.09, nhipRung: 17,[39m
[31m+           loc: 'lowpass', fLoc: 780, fLoc1: 380, qLoc: 4, lech: 14, vang: 0.4 })[39m
[31m+         this.giong({ tre: T + 0.02, dang: 'triangle', f0: 320, fGiua: 480, f1: 300, to: 0.16,[39m
[31m+           len: 0.05, giu: 0.36, tat: 0.4, rung: 0.05, nhipRung: 9,[39m
[31m+           loc: 'bandpass', fLoc: 1100, qLoc: 3, vang: 0.42 })[39m
[31m+         for (let i = 0; i < 14; i++) {[39m
[31m+           this.on({ tre: T + 0.12 + i * 0.045 + Math.random() * 0.02, to: 0.14,[39m
[31m+             len: 0.001, giu: 0.001, tat: 0.05,[39m
[31m+             loc: 'highpass', f0: 4200 + Math.random() * 5000, q: 2, vang: 0.5 })[39m
[31m+         }[39m
[31m+         break[39m
[31m+       case 'sangy':[39m
[31m+         // COSMIC CONSCIOUSNESS ILLUMINATION — Vô Cực Diệu Giác:[39m
[31m+         this.giong({ tre: T, dang: 'sine', f0: 880, fGiua: 2640, f1: 1760, to: 0.5,[39m
[31m+           len: 0.04, giu: 0.55, tat: 0.7, rung: 0.04, nhipRung: 12,[39m
[31m+           loc: 'bandpass', fLoc: 2200, qLoc: 6, lech: 7, vang: 0.8 })[39m
[31m+         this.on({ tre: T, to: 0.22, len: 0.02, giu: 0.45, tat: 0.6,[39m
[31m+           loc: 'highpass', f0: 3500, f1: 9500, q: 1.2, vang: 0.75 })[39m
[31m+         break[39m
[31m+       case 'bieton':[39m
[31m+         // LE CHATELIER EQUILIBRIUM FLOURISH — Vạn Cổ Cân Bằng Hoa Trận:[39m
[31m+         this.giong({ tre: T, dang: 'triangle', f0: 440, fGiua: 554, f1: 659, to: 0.45,[39m
[31m+           len: 0.06, giu: 0.6, tat: 0.7, rung: 0.02, nhipRung: 6,[39m
[31m+           loc: 'lowpass', fLoc: 1200, qLoc: 1.8, lech: 5, vang: 0.7 })[39m
[31m+         this.on({ tre: T + 0.1, to: 0.15, len: 0.05, giu: 0.4, tat: 0.6,[39m
[31m+           loc: 'bandpass', f0: 1200, f1: 3000, q: 2, vang: 0.65 })[39m
[31m+         break[39m
[31m+       default:[39m
[31m+         // COVALENT SOUL HARMONY — Hồng Tinh Đồng Tâm:[39m
