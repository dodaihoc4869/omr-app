[31m+ export async function napToanBoCaLenMayChuMoi([39m
[31m+   scriptUrl: string,[39m
[31m+   secret: string,[39m
[31m+   bao?: (xong: number, tong: number, viec: string) => void,[39m
[31m+ ): Promise<KetQuaNapCa> {[39m
[31m+   if (dangNapCa) throw new Error('Lượt chuyển trước còn đang chạy — đợi nó xong đã')[39m
[31m+   dangNapCa = true[39m
[31m+   try {[39m
[31m+     const ch = await layCauHinhMayChu()[39m
[31m+     if (!ch.BAT || !ch.URL) throw new Error('Chưa bật máy chủ mới trong Cài đặt')[39m
[31m+[39m
[31m+     // HAI lượt gọi Apps Script cho TOÀN BỘ kho, không phải một lượt mỗi ca.[39m
[31m+     bao?.(0, 3, 'đọc danh sách ca')[39m
[31m+     const dsCa = await danhSachCaThat(scriptUrl, secret, false, true)[39m
[31m+     const dsXoa = await danhSachCaThat(scriptUrl, secret, true, true)[39m
[31m+     const tatCa = [...dsCa, ...dsXoa][39m
[31m+[39m
[31m+     bao?.(1, 3, `đẩy ${tatCa.length} ca`)[39m
[31m+     const goiCa: CaDayNhieu[] = tatCa.map((c) => ({[39m
[31m+       maCa: c.maCa,[39m
[31m+       tenCa: c.tenCa,[39m
[31m+       lop: c.lop,[39m
[31m+       thoiGianPhut: c.thoiGianPhut,[39m
[31m+       moLuc: c.moLuc,[39m
[31m+       batDau: c.batDau,[39m
[31m+       hetHanVao: c.hetHanVao,[39m
[31m+       trangThai: c.trangThai,[39m
[31m+       phamVi: String(c.phamVi ?? 'tu_do'),[39m
