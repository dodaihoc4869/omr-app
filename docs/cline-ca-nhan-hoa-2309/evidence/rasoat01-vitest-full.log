[31m+   deRieng?: boolean[39m
[31m+   /** Phạm vi lấy câu sai của ca đề riêng: 'gan_nhat' | 'ba_ca'. */[39m
[31m+   phamViHoiLai?: 'gan_nhat' | 'ba_ca'[39m
[31m+   daVao: number[39m
[31m+   daNop: number[39m
