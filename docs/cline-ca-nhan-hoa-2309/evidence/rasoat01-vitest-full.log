[31m+     if (!r.ok) return { de: null, loi: String(r.error || 'Không lấy được đề của dạng bài này') }[39m
[31m+     return { de: r.de ?? null, loi: '' }[39m
[31m+   } catch (e) {[39m
[31m+     return { de: null, loi: e instanceof Error ? e.message : 'Không kết nối được máy chủ' }[39m
[31m+   }[39m
[31m+ }[39m
