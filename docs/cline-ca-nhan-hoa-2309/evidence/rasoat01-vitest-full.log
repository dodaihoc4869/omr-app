[31m+[39m
[31m+ /** Khối lớp suy từ năm sinh theo năm học hiện tại (vào lớp 1 lúc 6 tuổi; năm[39m
[31m+  * học mới tính từ tháng 9). 2010 → lớp 11 trong năm học 2026–2027. */[39m
[31m+ export function khoiTuNamSinh(namSinh: string | number, now: Date = new Date()): number | null {[39m
[31m+   const ns = Number(namSinh)[39m
[31m+   if (!Number.isFinite(ns) || ns < 1990 || ns > now.getFullYear()) return null[39m
[31m+   const namHoc = now.getMonth() >= 8 ? now.getFullYear() : now.getFullYear() - 1[39m
[31m+   return namHoc - ns - 5[39m
[31m+ }[39m
