[31m+   min-height: 48px; padding: 0 20px; border: 1px solid var(--vien-dam); border-radius: 999px;[39m
[31m+   background: #ffffff; color: var(--nav); font: inherit; font-size: 14px; font-weight: 800;[39m
[31m+   cursor: pointer; transition: background-color var(--muot), border-color var(--muot), transform var(--muot), box-shadow var(--muot);[39m
[31m+ }[39m
[31m+ .nut:hover { background: #f1f5f9; border-color: var(--nav); }[39m
