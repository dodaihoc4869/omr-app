[31m+       if (!xong) {[39m
[31m+         await ghiDiemMoi([39m
[31m+           chMoi,[39m
[31m+           secret,[39m
[31m+           maCa,[39m
[31m+           nhan.map((x) => ({ sbd: String(x.sbd), lanThu: Number(x.lanThu) || 1, hoTen: String((x as { hoTen?: string }).hoTen ?? ''), diem: x.diem })),[39m
[31m+         )[39m
[31m+       }[39m
[31m+     }[39m
[31m+   } catch {[39m
