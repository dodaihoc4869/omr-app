[31m+   // Máy mới có thể chưa lưu cấu hình, hoặc lần nạp lúc khởi động vừa trượt.[39m
[31m+   // Cùng bộ tìm địa chỉ của HS/PH sẽ thử lại tệp cấu hình công khai.[39m
[31m+   const diaChi = await layDiaChiMayChu(_scriptUrl)[39m
[31m+   // KHÔNG ÂM THẦM QUAY VỀ GOOGLE. Thiếu địa chỉ thì nói thẳng, vì cái sai ở đây[39m
[31m+   // là cấu hình chứ không phải mạng — và im lặng đi đường cũ là đúng thứ thầy[39m
[31m+   // vừa bảo dẹp.[39m
[31m+   if (!diaChi) throw new Error('Chưa có địa chỉ máy chủ mới — vào Cài đặt → Kết nối máy chủ')[39m
[31m+   const res = await fetchCoHan([39m
[31m+     `${diaChi}/goi`,[39m
[31m+     {[39m
[31m+       method: 'POST',[39m
[31m+       headers: { 'Content-Type': 'text/plain;charset=utf-8' },[39m
[31m+       body: JSON.stringify(body),[39m
[31m+     },[39m
[31m+     giay,[39m
[31m+   )[39m
[31m+   if (!res.ok) throw new Error(`Máy chủ trả lỗi HTTP ${res.status}`)[39m
[31m+   const r = await res.json()[39m
[31m+   // Mọi phản hồi có serverNow → hiệu chỉnh đồng hồ theo máy chủ ngay tại đây,[39m
[31m+   // màn hình không phải nhớ gọi.[39m
[31m+   if (r && typeof r.serverNow === 'number') dongBoGioMayChu(r.serverNow)[39m
[31m+   // Phản hồi `danhSachCa` mang mốc reset dữ liệu học sinh (`mocReset`, chỉ có SAU khi máy chủ reset xong): dọn bộ nhớ ca cũ trong[39m
[31m+   // máy thầy NGAY ĐÂY, trước khi ai cất thêm gì vào cache. Đường máy chủ mới `danhSachCaMoi` làm việc này ở `man-ca-may-chu-moi.ts`.[39m
[31m+   if (r && (body as { action?: unknown } | null)?.action === 'danhSachCa') await donTheoMocReset(r.mocReset)[39m
[31m+   return r[39m
[31m+ }[39m
