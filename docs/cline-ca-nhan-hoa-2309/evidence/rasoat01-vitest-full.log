[31m+ // ============================================================================[39m
[31m+ // LỊCH SỬ CA THI + CHI TIẾT + XOÁ MỀM + GHI ĐIỂM/CHI TIẾT CÂU (QUANLYCATHI 2, 5)[39m
[31m+ // Tất cả cần MA_BI_MAT (máy thầy); ghiDiem chấp nhận thêm idThietBi của chính lượt (máy em).[39m
[31m+ // ============================================================================[39m
[31m+[39m
[31m+ export interface CaTomTat {[39m
[31m+   maCa: string[39m
[31m+   tenCa: string[39m
[31m+   lop: string[39m
