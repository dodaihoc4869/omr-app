[31m+     let mocMatTieuDiem: number | null = null[39m
[31m+     const nhipTieuDiem = window.setInterval(() => {[39m
[31m+       if (daKhoa) return[39m
[31m+       const noi = laCuaSoNoi({ coTieuDiem: document.hasFocus(), manConHien: document.visibilityState === 'visible' })[39m
[31m+       if (!noi) {[39m
[31m+         mocMatTieuDiem = null[39m
[31m+         return[39m
[31m+       }[39m
[31m+       const nay = performance.now()[39m
[31m+       if (mocMatTieuDiem === null) {[39m
[31m+         mocMatTieuDiem = nay[39m
[31m+         che('Bài thi tạm ẩn khi có cửa sổ khác đè lên. Quay lại để làm tiếp.')[39m
[31m+         return[39m
