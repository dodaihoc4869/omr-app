[31m+   // MỐC GIỜ TÍNH Ở MÁY THẦY, RỒI GỬI KÈM — không để hai nơi tự tính.[39m
[31m+   //[39m
[31m+   // Luật bên Apps Script (`publish`): `batDau = body.batDau hợp lệ ? body.batDau[39m
[31m+   // : Date.now()`, và `hetHanVao = hanVaoPhut > 0 ? batDau + hanVaoPhut phút :[39m
[31m+   // body.hetHanVao`. Tính sẵn rồi gửi kèm thì nhánh `body.batDau` luôn trúng,[39m
[31m+   // hai bên ra ĐÚNG MỘT chuỗi — và máy thầy biết mốc giờ TRƯỚC khi Apps Script[39m
[31m+   // trả lời, nên hai lượt ghi chạy song song được.[39m
[31m+   //[39m
[31m+   // Không tính sẵn thì `Date.now()` bên Apps Script khác đồng hồ máy thầy vài[39m
[31m+   // giây, và đó đúng là kiểu lệch âm thầm không ai thấy cho tới lúc em vào[39m
[31m+   // muộn bị chặn oan.[39m
[31m+   const batDauMs = mocMsHopLe(moc.batDau) ?? Date.now()[39m
[31m+   const batDauISO = new Date(batDauMs).toISOString()[39m
[31m+   const hanPhut = Number(moc.hanVaoPhut) || 0[39m
[31m+   const hetHanMs = hanPhut > 0 ? batDauMs + hanPhut * 60000 : mocMsHopLe(moc.hetHanVao)[39m
[31m+   const hetHanISO = hetHanMs === null ? '' : new Date(hetHanMs).toISOString()[39m
[31m+[39m
[31m+   // HAI LƯỢT GHI CHẠY SONG SONG.[39m
[31m+   //[39m
[31m+   // Bản cũ ghi Sheet xong MỚI đẩy sang máy chủ mới, nên "bấm mở ca" tốn[39m
[31m+   // `AppsScript + D1`. Lượt `publish` bên Apps Script ghi cả gói đề vào bảng —[39m
[31m+   // đó là lượt nặng nhất của cả buổi, và thầy báo "bấm bắt đầu mở ca là cực kì[39m
[31m+   // chậm".[39m
[31m+   //[39m
[31m+   // Nay tốn `max(AppsScript, D1)`. Và quan trọng hơn tốc độ: gói đề lên R2 và[39m
[31m+   // dòng ca vào D1 KHÔNG còn bị chặn sau lượt Sheet, nên Apps Script chậm hay[39m
[31m+   // hỏng thì ca VẪN sẵn sàng trên máy chủ mới cho cả lớp vào thi.[39m
[31m+   const dayMayChuMoi = (async (): Promise<boolean> => {[39m
[31m+       const [diaChi, cauHinh, matThay] = await voiHanCho(Promise.all([[39m
[31m+         layDiaChiMayChu(_scriptUrl), layCauHinhMayChu(), loadTeacherSecret(),[39m
[31m+       ]), 10000, 'Chưa đọc được cấu hình trên máy. Thầy đóng các tab app khác rồi mở lại app giáo viên.')[39m
[31m+       const chMoi = { ...cauHinh, URL: diaChi, BAT: !!diaChi }[39m
[31m+       const daLuu = await taoCaDaXacNhan([39m
[31m+         chMoi,[39m
[31m+         matThay,[39m
[31m+         {[39m
[31m+           maCa,[39m
[31m+           tenCa: moc.tenCa || '',[39m
[31m+           trangThai: 'mo',[39m
[31m+           batDau: batDauISO,[39m
[31m+           hetHanVao: hetHanISO,[39m
[31m+           thoiGianPhut,[39m
[31m+           soCau: bank.soCau,[39m
[31m+           loai: moc.loai || 'thi',[39m
[31m+           hanNop: moc.hanNop || '',[39m
[31m+           congBo: congBoDiem,[39m
[31m+           nguongLan: moc.nguongLan || 0,[39m
[31m+           nguongGiay: moc.nguongGiay || 0,[39m
[31m+           lop,[39m
[31m+           phongCho: moc.phongCho === true || moc.dongBoGio === true,[39m
[31m+           dongBoGio: moc.dongBoGio === true,[39m
[31m+           giuDeDoc: moc.giuDeDoc === true,[39m
[31m+           anHanGiay: moc.giuDeDoc === true ? moc.anHanGiay || 3 : 0,[39m
[31m+           // BỐN CỜ NÀY TRƯỚC ĐÂY CHỈ SỐNG BÊN SHEET. Cắt Sheet mà quên chúng là[39m
[31m+           // mất cổng chặn phạm vi, mất chế độ đề riêng và mất cờ gọi lên bảng —[39m
[31m+           // đúng loại hỏng chỉ lộ ra giữa ca thật.[39m
[31m+           phamVi: moc.phamVi || 'tu_do',[39m
[31m+           danhSachMoi:[39m
[31m+             moc.phamVi === 'chon'[39m
[31m+               ? Array.isArray(moc.danhSachMoi)[39m
[31m+                 ? moc.danhSachMoi[39m
[31m+                 : [][39m
[31m+               : moc.phamVi === 'khoi'[39m
[31m+                 ? String(moc.danhSachMoi ?? '')[39m
[31m+                 : '',[39m
[31m+           lenBang: moc.lenBang !== false,[39m
[31m+           deRieng: moc.deRieng === true,[39m
[31m+           phamViHoiLai: moc.phamViHoiLai === 'ba_ca' ? 'ba_ca' : 'gan_nhat',[39m
[31m+           matKhau: moc.matKhau?.trim() || undefined,[39m
[31m+           chiNop3PhutCuoi: moc.chiNop3PhutCuoi === true,[39m
[31m+         },[39m
[31m+         bank,[39m
[31m+         // NGÂN HÀNG CÓ ĐÁP ÁN — LUÔN GỬI, không phụ thuộc cách công bố.[39m
[31m+         //[39m
[31m+         // Bản trước chỉ gửi khi ca công bố NGAY. Hậu quả bắt được ở ca 195422[39m
[31m+         // sáng 12/09 (`cong_bo = 'ca_lop_xong'`): R2 không có `key/195422.json`,[39m
[31m+         // nên `phieuCuaEm` trả `bank: null` và LINK XEM ĐIỂM của cả ca báo "Máy[39m
[31m+         // chủ chưa gửi đề của ca này — báo Thầy". Xem điểm cần đáp án dù ca[39m
[31m+         // công bố kiểu gì.[39m
[31m+         //[39m
[31m+         // Vẫn kín: khoá `key/` không bao giờ đi ra đường công khai `GET[39m
[31m+         // /de/:maCa`; `phieuCuaEm` chỉ trả nó cho lượt ĐÃ NỘP của chính em;[39m
[31m+         // `congBoSauNop` vẫn chỉ trả khi ca công bố NGAY.[39m
[31m+         keyBank,[39m
[31m+       )[39m
[31m+       return daLuu[39m
[31m+   })()[39m
[31m+[39m
[31m+   // KHÔNG CÒN LƯỢT GHI GOOGLE SHEET.[39m
[31m+   //[39m
[31m+   // Thầy chốt 12/09 rạng sáng: "không ghi điểm vào google sheet nữa" và "gỡ[39m
[31m+   // sạch google". Trước đây mở một ca là ghi HAI nơi: D1 (nhanh) và Sheet[39m
[31m+   // (chậm, chạy nền, có sổ theo dõi ở `ghi-sheet-nen.ts`). Giờ chỉ còn D1.[39m
[31m+   //[39m
[31m+   // ĐẨY HỎNG THÌ BÁO ĐỎ, KHÔNG có đường dự phòng nào nữa. Đó là điều phải nói[39m
[31m+   // thẳng: trước kia Sheet đỡ cho lượt đẩy hỏng, giờ thì không. Trả lời "đã mở"[39m
[31m+   // khi ca không nằm ở đâu cả là thứ tệ nhất có thể làm ở màn này, nên thà báo[39m
