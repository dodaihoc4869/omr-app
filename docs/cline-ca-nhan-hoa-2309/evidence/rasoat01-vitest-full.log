[31m+ .nut.chinh {[39m
[31m+   background: linear-gradient(135deg, var(--nav), var(--luc)); border-color: transparent; color: #ffffff;[39m
[31m+   box-shadow: 0 2px 4px rgba(15,48,87,.10), 0 10px 22px -8px rgba(0,136,145,.55);[39m
[31m+ }[39m
[31m+ .nut.chinh:hover { filter: brightness(1.08); }[39m
[31m+ /* Nút phụ ĐẶC, không viền rỗng: trong ảnh thầy chốt 06/09 nó là viên thuốc[39m
[31m+    xanh đậm đứng cạnh nút chính, không phải một cái khung trắng. */[39m
[31m+ .nut.dam { background: var(--nav); border-color: transparent; color: #ffffff; }[39m
[31m+ .nut.dam:hover { background: var(--nav); filter: brightness(1.14); }[39m
[31m+ .nut:focus-visible { outline: 3px solid rgba(0,136,145,.4); outline-offset: 2px; }[39m
[31m+[39m
[31m+ /* MỘT NÚT, HAI NHÃN. Nhãn "đóng" ẩn sẵn, chỉ hiện khi nút đang ở trạng thái[39m
[31m+    mở. Quy tắc này phải phủ CẢ nút trong thẻ câu lẫn nút trên thanh — bản trước[39m
