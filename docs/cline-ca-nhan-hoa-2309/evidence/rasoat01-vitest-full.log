[31m+     } catch (e) {[39m
[31m+       kq.loi.push({ maCa, loi: e instanceof Error ? e.message : 'lỗi không rõ' })[39m
[31m+     }[39m
[31m+   }[39m
[31m+   return kq[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Xoá VĨNH VIỄN một hoặc nhiều ca thi khỏi hệ thống — toàn bộ bài làm và dữ liệu ca bị xoá sạch, không thể khôi phục. */[39m
