[31m+     const daGhi = new Set((r.daGhi ?? []).map((x: unknown) => String(x)))[39m
[31m+     const nhan = bai.filter((x) => daGhi.size === 0 || daGhi.has(String(x.sbd)))[39m
[31m+     if (nhan.length > 0) {[39m
[31m+       const chMoi = await layCauHinhMayChu()[39m
[31m+       // GỬI TRỌN GÓI, kể cả `cau` — máy chủ mới dựng luôn chi tiết từng câu,[39m
[31m+       // tiến độ theo ca, bảng mạnh–yếu, câu đã làm và bản đồ câu sai. Gửi mỗi[39m
[31m+       // điểm thôi thì năm bảng kia mãi mãi rỗng bên này.[39m
