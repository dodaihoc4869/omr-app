[31m+   // ── TIẾNG KÊU: SÁU HỆ SÁU GIỌNG ──────────────────────────────────────────[39m
[31m+[39m
[31m+   /**[39m
[31m+    * Chạm vào thú là nó kêu. Mỗi tiếng là ba đến bốn lớp chồng nhau, vì một[39m
[31m+    * lớp đơn thì dù chỉnh kiểu sóng gì cũng vẫn ra tiếng máy.[39m
[31m+    */[39m
[31m+   keu(he: string): void {[39m
[31m+     this.moKhoa()[39m
[31m+     if (!this.bat) return[39m
[31m+     switch (he) {[39m
[31m+       case 'dat':[39m
[31m+       case 'kiem': return this.keuBase()[39m
[31m+       case 'nuoc':[39m
[31m+       case 'axit': return this.keuAcid()[39m
[31m+       case 'lua':[39m
[31m+       case 'hoa': return this.keuHoa()[39m
[31m+       case 'khi': return this.keuKhi()[39m
[31m+       case 'ductin':[39m
