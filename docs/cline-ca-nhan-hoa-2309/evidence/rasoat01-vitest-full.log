[31m+   /**[39m
[31m+    * CHƯỞNG CUỒNG NỘ — ba tầng, khớp đúng nhịp hình:[39m
[31m+    *   0,00–0,45s  RÍT DÂNG, chạy song song lúc thần thú dồn lực[39m
[31m+    *   0,45–0,95s  CÚ GIÁNG: hạ âm tụt sâu + vỡ dải rộng + chuông kim loại[39m
[31m+    *   0,95–1,7s   ĐUÔI VANG rút dần[39m
[31m+    */[39m
[31m+   /**[39m
[31m+    * SÁU TIẾNG CHƯỞNG TỐI THƯỢNG — mỗi hệ một tiếng, đúng sáu chiêu thầy chốt.[39m
[31m+    *[39m
[31m+    * Gọi kèm `kichNo()`: `kichNo` lo phần SỨC NẶNG chung (rít dâng, cú giáng hạ[39m
[31m+    * âm, đuôi vang), còn hàm này lo phần CHẤT RIÊNG của từng chiêu. Tách hai[39m
[31m+    * tầng vì nếu nhét hết vào một hàm thì sáu tiếng lại ra sáu biến thể của[39m
[31m+    * cùng một tiếng nổ — đúng lỗi bản âm thanh đầu tiên.[39m
[31m+    */[39m
[31m+   chuongToiThuong(he: string): void {[39m
[31m+     this.moKhoa()[39m
[31m+     if (!this.bat) return[39m
[31m+     const T = 0.45[39m
[31m+     switch (he) {[39m
[31m+       case 'khi':[39m
[31m+         // ULTIMATE JADE BLAST — chùm tia bích ngọc: tiếng nạp rồi RÍT DÀI,[39m
[31m+         // cao độ trượt lên như tia laze xuyên qua không khí.[39m
[31m+         this.giong({ tre: T, dang: 'sawtooth', f0: 220, fGiua: 1650, f1: 1180, to: 0.46,[39m
[31m+           len: 0.04, giu: 0.5, tat: 0.5, rung: 0.02, nhipRung: 30,[39m
[31m+           loc: 'bandpass', fLoc: 1400, fLoc1: 3200, qLoc: 6, lech: 9, vang: 0.4 })[39m
[31m+         this.on({ tre: T, to: 0.26, len: 0.05, giu: 0.42, tat: 0.4,[39m
[31m+           loc: 'highpass', f0: 2000, f1: 8000, q: 0.8, vang: 0.5 })[39m
[31m+         this.giong({ tre: T, dang: 'sine', f0: 76, f1: 58, to: 0.34,[39m
[31m+           len: 0.03, giu: 0.5, tat: 0.55, loc: 'lowpass', fLoc: 260, qLoc: 1.2, vang: 0.35 })[39m
[31m+         break[39m
[31m+       case 'nuoc':[39m
[31m+       case 'axit':[39m
[31m+         // HYDROGEN VORTEX TSUNAMI — tia vương miện ngân hà / hải triều liên kết hydro:[39m
[31m+         this.giong({ tre: T, dang: 'sine', f0: 1320, f1: 1760, to: 0.5, len: 0.03,[39m
[31m+           giu: 0.46, tat: 0.7, loc: 'bandpass', fLoc: 2400, qLoc: 9, lech: 5, vang: 0.75 })[39m
[31m+         this.giong({ tre: T + 0.04, dang: 'sine', f0: 2640, to: 0.24, len: 0.02,[39m
[31m+           giu: 0.3, tat: 0.62, vang: 0.8 })[39m
[31m+         this.giong({ tre: T, dang: 'sine', f0: 82, f1: 64, to: 0.34, len: 0.03,[39m
