[31m+ }[39m
[31m+[39m
[31m+ /** BẢN ĐỒ SAI TỪNG CÂU của mấy ca, đọc MỘT LƯỢT từ máy chủ.[39m
[31m+  *[39m
[31m+  * Thầy chốt 08/09: "Ca thi nào cũng phải dựng sẵn bản đồ sai từng câu". Máy[39m
[31m+  * chủ ghi bản đồ ngay lúc chấm, nên chế độ đề riêng không phải chấm lại từng[39m
[31m+  * ca cũ ở máy thầy — máy nào cũng dựng đề được, kể cả máy chưa từng mở ca đó.[39m
[31m+  *[39m
[31m+  * Trả `{ maCa: { sai: {sbd:[qid]}, lam: {sbd:[qid]} } }`. Ca chưa có bản đồ[39m
[31m+  * trả hai bản đồ rỗng, chỗ gọi tự biết phải dựng lại bằng cách cũ. */[39m
[31m+ export async function banDoSaiCa([39m
[31m+   scriptUrl: string,[39m
[31m+   secret: string,[39m
[31m+   dsMaCa: string[],[39m
[31m+ ): Promise<Record<string, { sai: Record<string, string[]>; lam: Record<string, string[]> }>> {[39m
[31m+   const ds = dsMaCa.map((x) => String(x || '').trim()).filter(Boolean)[39m
[31m+   if (ds.length === 0) return {}[39m
[31m+   const r = await postJson(scriptUrl, { action: 'banDoSaiCa', secret, dsMaCa: ds })[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không đọc được bản đồ sai')[39m
[31m+   const ra: Record<string, { sai: Record<string, string[]>; lam: Record<string, string[]> }> = {}[39m
[31m+   const goc = (r.ca ?? {}) as Record<string, { sai?: Record<string, string[]>; lam?: Record<string, string[]> }>[39m
[31m+   for (const [ma, v] of Object.entries(goc)) ra[ma] = { sai: v?.sai ?? {}, lam: v?.lam ?? {} }[39m
[31m+   return ra[39m
[31m+ }[39m
[31m+[39m
[31m+ /** HỒ SƠ ÔN CHO RÚT ĐỀ RIÊNG (GĐ 6 Kênh 1, 19/09) — lệnh máy chủ MỚI `hoSoOnCa`.[39m
[31m+  *[39m
[31m+  * Hợp đồng: `docs/hop-dong-ho-so-on-ca-1909.md`. Mỗi lượt ≤ 20 em (máy chủ chặn[39m
[31m+  * cứng) — chỗ gọi tự chia lô. Trả NGUYÊN phần `em` máy chủ gửi về, chưa tin kiểu[39m
[31m+  * nào: đọc phòng thủ là việc của `docHoSoOnEm` (`de-rieng.ts`).[39m
[31m+  *[39m
[31m+  * Máy chủ đời cũ chưa có lệnh ⇒ `ok:false` ⇒ NÉM LỖI. Chỗ gọi bắt lỗi và rút đề[39m
[31m+  * đúng như trước 19/09 — đừng nuốt lỗi ở đây rồi trả `{}`: "không em nào có hồ[39m
[31m+  * sơ" và "máy chủ không có lệnh" là hai chuyện khác nhau. */[39m
[31m+ export async function hoSoOnCa([39m
[31m+   scriptUrl: string,[39m
[31m+   secret: string,[39m
[31m+   dsSbd: string[],[39m
[31m+   maCa: string,[39m
[31m+   ngayCa: string,[39m
[31m+   soCa: 1 | 3 = 1,[39m
[31m+ ): Promise<Record<string, unknown>> {[39m
[31m+   const ds = [...new Set(dsSbd.map((x) => String(x || '').trim()).filter(Boolean))][39m
[31m+   if (ds.length === 0) return {}[39m
