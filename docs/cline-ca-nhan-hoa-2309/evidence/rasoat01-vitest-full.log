[31m+ }[39m
[31m+ export interface LopDangBai {[39m
[31m+   lop: string[39m
[31m+   bais: BaiDangBai[][39m
[31m+ }[39m
[31m+[39m
[31m+ /** MENU luyện dạng bài. Lỗi mạng KHÔNG ném ra — màn hình chỉ cần biết[39m
[31m+  * "có menu hay không" và "vì sao không". */[39m
[31m+ export async function danhMucDangBai([39m
[31m+   scriptUrl: string,[39m
[31m+ ): Promise<{ lops: LopDangBai[]; tongDang: number; loi: string }> {[39m
[31m+   try {[39m
[31m+     const r = await postJson(scriptUrl, { action: 'danhMucDangBai' }, 30)[39m
[31m+     if (!r.ok) return { lops: [], tongDang: 0, loi: String(r.error || 'Không lấy được danh mục dạng bài') }[39m
[31m+     const lops: LopDangBai[] = (Array.isArray(r.lops) ? r.lops : []).map((l: any) => ({[39m
[31m+       lop: String(l?.lop ?? ''),[39m
[31m+       bais: (Array.isArray(l?.bais) ? l.bais : []).map((b: any) => ({[39m
[31m+         tenBai: String(b?.tenBai ?? ''),[39m
[31m+         dangs: (Array.isArray(b?.dangs) ? b.dangs : []).map((d: any) => ({[39m
[31m+           ma: String(d?.ma ?? ''),[39m
[31m+           ten: String(d?.ten ?? ''),[39m
[31m+           soCau: Number(d?.soCau) || 0,[39m
[31m+         })),[39m
[31m+       })),[39m
[31m+     }))[39m
[31m+     return { lops, tongDang: Number(r.tongDang) || 0, loi: '' }[39m
[31m+   } catch (e) {[39m
[31m+     return { lops: [], tongDang: 0, loi: e instanceof Error ? e.message : 'Không kết nối được máy chủ' }[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Tờ đề gom TRỌN câu của một dạng bài. Gói có thể tới vài MB (câu có ảnh) nên[39m
[31m+  * để hạn 60 giây như `cauKhacPhuc`, không phải 25 mặc định. */[39m
[31m+ export async function deTheoDangBai([39m
