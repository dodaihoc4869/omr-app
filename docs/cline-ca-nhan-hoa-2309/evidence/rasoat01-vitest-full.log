[31m+[39m
[31m+ /** Xoá MỀM một ca — phải gõ lại đúng mã ca (xacNhan). Bài làm/điểm giữ nguyên trên Sheet. */[39m
[31m+ export async function xoaCa(scriptUrl: string, secret: string, maCa: string, xacNhan: string): Promise<void> {[39m
