[31m+     // Chạm: một cú gõ trầm ngắn cho có trọng lượng.[39m
[31m+     this.giong({ tre: 0.1, dang: 'triangle', f0: 260, f1: 90, to: 0.2, giu: 0.02, tat: 0.14, vang: 0.12 })[39m
[31m+   }[39m
