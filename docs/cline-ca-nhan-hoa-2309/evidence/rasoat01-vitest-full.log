[31m+ /** Mốc giờ hợp lệ thành mili giây; rỗng hay hỏng thì `null`. */[39m
[31m+ function mocMsHopLe(v: unknown): number | null {[39m
[31m+   const t = Date.parse(String(v ?? ''))[39m
[31m+   return Number.isFinite(t) ? t : null[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Loại ca: kiểm tra hay bài tập về nhà. Dùng CHUNG mọi thứ, khác nhau bằng cờ này. */[39m
[31m+ export type LoaiCa = 'thi' | 'baitap'[39m
[31m+[39m
[31m+ export async function publishSession([39m
[31m+   /** GIỮ TRONG CHỮ KÝ để chỗ gọi không phải sửa; từ 12/09 không còn được dùng[39m
