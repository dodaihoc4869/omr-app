[31m+           osc.frequency.exponentialRampToValueAtTime(Math.max(20, o.f1), het)[39m
[31m+         }[39m
[31m+         if (sauLfo !== null) sauLfo.connect(osc.frequency)[39m
[31m+         osc.connect(g)[39m
[31m+         osc.start(t)[39m
[31m+         osc.stop(het + 0.02)[39m
[31m+       }[39m
[31m+     } catch { /* thiết bị không cho phát thì im, không làm vỡ màn hình */ }[39m
[31m+   }[39m
[31m+[39m
[31m+   /** Một lớp hơi/nhiễu qua bộ lọc quét — tiếng thở, xèo, vút, vỡ. */[39m
[31m+   private on(o: TuyOn): void {[39m
[31m+     const ctx = this.san()[39m
[31m+     if (ctx === null || this.onTrang === null) return[39m
[31m+     try {[39m
[31m+       const t = ctx.currentTime + (o.tre ?? 0)[39m
[31m+       const len = o.len ?? 0.008[39m
[31m+       const het = t + len + o.giu + o.tat[39m
[31m+[39m
[31m+       const n = ctx.createBufferSource()[39m
[31m+       n.buffer = this.onTrang[39m
[31m+       n.loop = true[39m
[31m+[39m
[31m+       const f = ctx.createBiquadFilter()[39m
[31m+       f.type = o.loc ?? 'bandpass'[39m
[31m+       f.frequency.setValueAtTime(Math.max(30, o.f0), t)[39m
[31m+       if (o.f1 !== undefined) f.frequency.exponentialRampToValueAtTime(Math.max(30, o.f1), het)[39m
[31m+       f.Q.setValueAtTime(o.q ?? 1, t)[39m
[31m+[39m
[31m+       const g = ctx.createGain()[39m
[31m+       this.bao(g, t, o.to, len, o.giu, o.tat)[39m
[31m+[39m
[31m+       n.connect(f)[39m
[31m+       f.connect(g)[39m
[31m+       g.connect(this.nen!)[39m
[31m+       if ((o.vang ?? 0) > 0 && this.guiVang !== null) {[39m
[31m+         const gv = ctx.createGain()[39m
[31m+         gv.gain.setValueAtTime(o.vang ?? 0, t)[39m
[31m+         g.connect(gv)[39m
[31m+         gv.connect(this.guiVang)[39m
[31m+       }[39m
[31m+       n.start(t)[39m
[31m+       n.stop(het + 0.02)[39m
[31m+     } catch { /* như trên */ }[39m
[31m+   }[39m
