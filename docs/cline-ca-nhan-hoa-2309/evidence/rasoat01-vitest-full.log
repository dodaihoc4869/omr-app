[31m+   //[39m
[31m+   // HẠN 90 GIÂY, không phải 25. Đo 08/09 khuya bằng hook `fetch`: `chamLaiCa`[39m
[31m+   // ca 248567 chết ở ĐÂY (`ghiDiem` một lô hỏng ở 25,3 giây) chứ không phải ở[39m
[31m+   // `chiTietCa` (xong trong 5 giây) như vòng đoán trước. Lượt này vừa xoá dòng[39m
[31m+   // chi tiết cũ vừa ghi hàng chục dòng mới — nặng nhất trong cả chuỗi.[39m
[31m+   const r = await postJson(scriptUrl, { action: 'ghiDiem', secret, maCa, bai, luatDiem: LUAT_DIEM, soCau }, 90)[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không ghi được điểm')[39m
