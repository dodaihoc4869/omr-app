[31m+         // đếm rời màn phía trên.[39m
[31m+         if (p.kenh === 'toan_man') {[39m
[31m+           if (camUngMay) return[39m
[31m+           if (document.fullscreenElement) return boChe()[39m
[31m+           che(LOI_KHOA.thoat_toan_man)[39m
[31m+           if (!conAnHan() && coKhoa(muc, 'thoat_toan_man')) khoaVi('thoat_toan_man', 'kênh 3')[39m
[31m+           return[39m
[31m+         }[39m
[31m+[39m
[31m+         // --- KÊNH 4: thu nhỏ / chia đôi màn. Bỏ qua tuyệt đối khi đang gõ ô[39m
[31m+         // nhập — bàn phím ảo lúc làm Phần III không bao giờ được gây khoá.[39m
[31m+         if (p.kenh === 'kich_thuoc') {[39m
[31m+           const dangGoO = document.activeElement instanceof HTMLInputElement || document.activeElement instanceof HTMLTextAreaElement[39m
[31m+           const kq = xetCoMan(coMan, { rong: bc.rong, cao: bc.cao, dangGoO, bayGio: p.luc, tiLe: TI_LE_CO_MAN_CHOT, msXacNhan: MS_XAC_NHAN_CO_MAN })[39m
[31m+           coMan = kq.tt[39m
[31m+           // MÁY CẢM ỨNG KHÔNG BỊ KHOÁ VÌ KÊNH NÀY — xem `khoaDuocViThuNhoMan`.[39m
