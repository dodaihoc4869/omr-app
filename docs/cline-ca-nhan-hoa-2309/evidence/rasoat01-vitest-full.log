[31m+   namSinhDs: string[39m
[31m+   lyDo: string[39m
[31m+ }[39m
[31m+[39m
[31m+ const TEN_LY_DO_CHAN: Record<string, string> = {[39m
[31m+   khong_co_sbd: 'Số báo danh không có trong danh sách lớp',[39m
[31m+   lech_ho_ten: 'Họ tên gõ khác danh sách',[39m
[31m+   lech_nam_sinh: 'Năm sinh gõ khác danh sách',[39m
[31m+   // KHÔNG phải một lượt bị chặn: em VÀO ĐƯỢC. Dòng này để thầy biết máy em còn[39m
[31m+   // giữ bản cũ (bản không có màn xác nhận tên), nên máy chủ không có gì để so.[39m
