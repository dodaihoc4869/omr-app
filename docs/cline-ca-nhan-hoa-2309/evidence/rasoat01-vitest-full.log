[31m+   font-size: 14px; font-weight: 500;[39m
[31m+   background: var(--chu-cai-nen); color: var(--chu-cai-muc); border: 1px solid var(--vien);[39m
[31m+   transition: background-color var(--muot), color var(--muot), border-color var(--muot);[39m
[31m+ }[39m
[31m+ .q-card.mo .tf-badge.d.dung { background: var(--dung-nen); color: var(--dung-muc); border-color: var(--dung); }[39m
[31m+ .q-card.mo .tf-badge.s.dung { background: var(--sai-nen); color: var(--sai-muc); border-color: var(--sai); }[39m
[31m+[39m
[31m+ .sa-vung { display: flex; align-items: center; min-height: 48px; }[39m
[31m+ .sa-blank {[39m
[31m+   flex: 1; padding: 12px 18px; border: 1.5px dashed var(--vien-dam); border-radius: var(--bo-nho);[39m
[31m+   font-size: 14px; color: var(--rat-nhat);[39m
[31m+ }[39m
[31m+ .sa-answer {[39m
[31m+   display: none; align-items: center; padding: 11px 24px; border-radius: var(--bo-nho);[39m
[31m+   background: linear-gradient(135deg, var(--nav), var(--luc)); color: #ffffff;[39m
[31m+   font-size: 19px; font-weight: 800; letter-spacing: .02em;[39m
[31m+ }[39m
[31m+ .q-card.mo .sa-blank { display: none; }[39m
[31m+ .q-card.mo .sa-answer { display: inline-flex; }[39m
[31m+[39m
[31m+ .q-hinh {[39m
[31m+   display: block; max-width: 100%; height: auto; margin: 12px auto;[39m
[31m+   border: 1px solid var(--vien); border-radius: var(--bo-nho); background: #ffffff;[39m
[31m+ }[39m
[31m+ .q-hinh.pa { max-height: 64px; margin: 0; border: none; background: transparent; }[39m
[31m+ .q-bang-cuon { overflow-x: auto; margin: 12px 0; }[39m
[31m+ .q-bang { width: 100%; border-collapse: collapse; font-size: 14px; }[39m
[31m+ .q-bang th, .q-bang td { border: 1px solid var(--vien-dam); padding: 7px 12px; text-align: center; color: var(--muc-2); white-space: nowrap; }[39m
[31m+ .q-bang th { background: var(--o-nen); font-weight: 700; }[39m
[31m+[39m
[31m+ /* ================= NÚT MỞ LỜI GIẢI ================= */[39m
[31m+ .q-nut-giai {[39m
[31m+   display: flex; align-items: center; gap: 8px; width: 100%;[39m
[31m+   min-height: 44px; padding: 0 16px; border: none; border-top: 1px solid var(--vien);[39m
[31m+   background: #f8fafc; color: var(--luc); font: inherit; font-size: 13.5px; font-weight: 700;[39m
[31m+   cursor: pointer; text-align: left;[39m
[31m+   transition: background-color var(--muot), color var(--muot);[39m
[31m+ }[39m
[31m+ .q-nut-giai:hover { background: #eef6f7; }[39m
[31m+ .q-nut-giai:focus-visible { outline: 3px solid rgba(0,136,145,.4); outline-offset: -3px; }[39m
[31m+ .q-card.mo .q-nut-giai { background: var(--kem-nen); color: var(--kem-nhan); border-top-color: var(--kem-vien); }[39m
[31m+ .q-mui { flex-shrink: 0; width: 16px; height: 16px; transition: transform var(--muot); }[39m
[31m+ .q-card.mo .q-mui { transform: rotate(180deg); }[39m
[31m+[39m
[31m+ /* ================= Ô LỜI GIẢI (GẬP / MỞ) =================[39m
[31m+    Chuyển động bằng grid-template-rows 0fr → 1fr: mở đúng chiều cao thật của[39m
[31m+    nội dung mà KHÔNG phải đo bằng JS, và không giật như cách đặt max-height ước[39m
[31m+    lượng. Trình duyệt cũ không chạy được thì nội dung vẫn hiện, chỉ mất hiệu[39m
[31m+    ứng trượt. */[39m
[31m+ .sol-wrap { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--muot); }[39m
[31m+ .q-card.mo .sol-wrap { grid-template-rows: 1fr; }[39m
[31m+ .sol-inner { overflow: hidden; min-height: 0; }[39m
[31m+ .sol-box {[39m
[31m+   margin: 0 16px 20px; padding: 22px 24px;[39m
[31m+   background: #fffdf5; border: 1.5px solid #fde68a; border-radius: 20px;[39m
[31m+   box-shadow: 0 4px 16px rgba(217,119,6,0.06);[39m
[31m+   opacity: 0; transform: translateY(-6px);[39m
[31m+   transition: opacity var(--muot), transform var(--muot);[39m
[31m+ }[39m
[31m+ .q-card.mo .sol-box { opacity: 1; transform: none; }[39m
[31m+ .sol-label {[39m
[31m+   font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em;[39m
[31m+   color: #92400e; margin-bottom: 6px;[39m
[31m+ }[39m
[31m+ .sol-label + .sol-label, .sol-text + .sol-label, .sol-step + .sol-label, .sol-dap + .sol-label { margin-top: 14px; }[39m
[31m+ /* Đáp án nổi bật rõ ràng chuẩn theo ảnh */[39m
[31m+ .sol-dap { font-size: 16px; color: #78350f; font-weight: 700; margin-bottom: 12px; }[39m
[31m+ .sol-dap b { font-size: 18px; font-weight: 900; color: #78350f; letter-spacing: .04em; }[39m
[31m+ .sol-text { font-size: 14.5px; line-height: 1.65; color: #78350f; overflow-wrap: break-word; }[39m
[31m+ .sol-text strong { color: #5b2a06; }[39m
[31m+ .sol-cot-loi { font-weight: 800; font-size: 15px; line-height: 1.65; color: #3b1d05; margin-bottom: 14px; }[39m
[31m+ .sol-pa { padding: 6px 0; font-size: 14px; line-height: 1.65; color: #78350f; }[39m
[31m+ .sol-pa + .sol-pa { border-top: 1px dashed rgba(146, 64, 14, .18); }[39m
[31m+ .sol-pa strong { color: #78350f; }[39m
[31m+ .sol-pa.chon { font-weight: 700; color: #14532d; }[39m
[31m+ .sol-step { font-size: 14.5px; line-height: 1.65; color: #78350f; padding-left: 18px; text-indent: -18px; }[39m
[31m+ .sol-ket { font-size: 15px; font-weight: 800; color: #451a03; }[39m
[31m+ /* Ảnh lời giải gốc chụp từ đề của tác giả. Nền trắng vì ảnh cắt ra là giấy[39m
[31m+    trắng mực đen; đặt trên nền kem của ô lời giải sẽ thấy một vệt lệch màu. */[39m
[31m+ .sol-anh { margin-top: 8px; }[39m
[31m+ .sol-anh img { display: block; width: 100%; height: auto; border-radius: 12px; background: #fff; border: 1px solid #fde68a; }[39m
[31m+ .sol-step + .sol-label, .sol-text + .sol-anh { margin-top: 12px; }[39m
[31m+[39m
[31m+ /* ============ TÊN EM HỎI (trang tổng hợp câu hỏi) ============[39m
[31m+    HOIBAITHAY.md mục 4D. Nằm ở ĐÂY chứ không ở một bảng kiểu riêng: cả app chỉ[39m
[31m+    có MỘT bộ dựng phiếu, thêm bộ thứ hai là hai trang bắt đầu lệch nhau. */[39m
[31m+ .cau-hoi-nhom { display: flex; flex-direction: column; }[39m
[31m+ .em-hoi {[39m
[31m+   margin: -4px 0 0; padding: 9px 14px;[39m
[31m+   border: 1px solid var(--vien); border-top: none;[39m
[31m+   border-radius: 0 0 12px 12px;[39m
[31m+   background: var(--the-nen);[39m
[31m+   font-size: 13.5px; line-height: 1.6; color: var(--muc-2);[39m
[31m+   overflow-wrap: break-word;[39m
[31m+ }[39m
[31m+ .em-hoi b { color: var(--muc); }[39m
[31m+ .em-ghi-chu { padding: 2px 14px 0; font-size: 13px; line-height: 1.6; color: var(--nhat); overflow-wrap: break-word; }[39m
[31m+ .em-ghi-chu:last-child { padding-bottom: 8px; }[39m
[31m+[39m
[31m+ /* ================= CHÂN TRANG ================= */[39m
[31m+ .chan { margin-top: 26px; text-align: center; font-size: 12.5px; line-height: 1.7; color: var(--nhat); }[39m
[31m+[39m
[31m+ /* CĂN GIỮA THEO NÉT CHỮ, KHÔNG THEO HỘP DÒNG.[39m
[31m+  *[39m
[31m+  * Căn giữa bằng flex chỉ đưa HỘP DÒNG vào giữa, mà hộp dòng còn chừa chỗ cho[39m
[31m+  * phần đuôi chữ đi xuống (g, y, p). Chữ A B C D, số, hay chữ Đ không dùng đến[39m
[31m+  * chỗ đó nên nét chữ luôn nằm CAO HƠN tâm ô tròn khoảng 1-2px.[39m
[31m+  *[39m
[31m+  * text-box-trim cắt đúng phần thừa trên đỉnh chữ hoa và dưới đường chân chữ,[39m
[31m+  * nên hộp chữ TRÙNG nét chữ và căn giữa thành chính xác.[39m
[31m+  *[39m
[31m+  * BẪY ĐÃ DÍNH: đặt thẳng lên .q-opt-letter KHÔNG ăn, vì ô đó là flex container[39m
[31m+  * — text-box-trim chỉ áp cho khối có dòng chữ thật bên trong. Phải bọc ký tự[39m
[31m+  * bằng một thẻ span riêng rồi cắt trên span đó. Trình duyệt cũ không hiểu thì[39m
[31m+  * bỏ qua, ô vẫn tròn chứ không vỡ. */[39m
[31m+ .ky {[39m
[31m+   display: block;[39m
[31m+   text-box-trim: trim-both;[39m
[31m+   text-box-edge: cap alphabetic;[39m
[31m+   text-box: trim-both cap alphabetic;[39m
[31m+ }[39m
[31m+ .q-opt-text, .q-tag, .tf-statement, .stat-number {[39m
[31m+   text-box-trim: trim-both;[39m
[31m+   text-box-edge: cap alphabetic;[39m
[31m+   text-box: trim-both cap alphabetic;[39m
[31m+ }[39m
[31m+[39m
[31m+ @media (max-width: 640px) {[39m
[31m+   .khung { padding: 0 10px 56px; }[39m
[31m+   .q-header { padding: 12px 12px 0; gap: 10px; }[39m
[31m+   .q-than { padding: 8px 12px 12px; }[39m
[31m+   .sol-box { margin: 0 12px 12px; }[39m
[31m+   .q-nut-giai { padding: 0 12px; }[39m
[31m+   .q-options { grid-template-columns: 1fr; }[39m
[31m+   /* Thanh gọn lại còn HAI dòng: dòng đếm, rồi hai nút chia đôi. Ba dòng như[39m
[31m+      bản đầu là thanh dính nuốt gần nửa màn điện thoại. */[39m
[31m+   .thanh { gap: 8px; padding: 8px 10px; }[39m
[31m+   .thanh-chu { flex: 1 0 100%; font-size: 12.5px; }[39m
[31m+   .thanh .nut { flex: 1; justify-content: center; padding: 0 10px; font-size: 13px; }[39m
[31m+   .q-card { scroll-margin-top: 104px; }[39m
[31m+ }[39m
[31m+[39m
[31m+ @media (prefers-reduced-motion: reduce) {[39m
[31m+   html { scroll-behavior: auto; }[39m
[31m+   * { transition-duration: .01ms !important; }[39m
[31m+ }[39m
[31m+[39m
[31m+ /* ================= BẢN IN =================[39m
[31m+    Bấm In rồi chọn "Lưu thành PDF" là ra bản chữ vector, nét và bôi đen chọn[39m
[31m+    được. Bản in MỞ SẴN mọi lời giải: trên giấy không bấm được. */[39m
[31m+ @media print {[39m
[31m+   :root, :root.dark, body.dark, [data-theme="dark"] { color-scheme: light; --nen: #ffffff; --the-nen: #ffffff; --muc: #0f172a; --muc-2: #334155; --nhat: #475569; --o-nen: #ffffff; --o-chu: #334155; --chu-cai-nen: #f1f5f9; --chu-cai-muc: #475569; --chon-nen: #eef2f6; --chon-vien: #2f3e46; }[39m
[31m+   body { background: #ffffff; }[39m
[31m+   .khung { max-width: none; padding: 0; }[39m
[31m+   /* Trên giấy không bấm được: bỏ thanh điều khiển, nút mở lời giải và mọi gợi[39m
[31m+      ý "bấm vào đây". Để lại là tờ giấy đầy chữ vô nghĩa. */[39m
[31m+   .thanh, .stat-loc, .chi-man { display: none; }[39m
[31m+   .cover { min-height: auto; height: 250mm; break-after: page; border-radius: 0; }[39m
[31m+   .summary-page { max-width: none; margin: 0 0 8mm; break-after: page; box-shadow: none; }[39m
[31m+   .q-card { box-shadow: none; break-inside: avoid; margin-bottom: 6mm; }[39m
[31m+   .q-card:hover { box-shadow: none; }[39m
[31m+   .q-nut-giai { display: none; }[39m
[31m+   .sol-wrap { grid-template-rows: 1fr !important; }[39m
[31m+   .sol-box { opacity: 1 !important; transform: none !important; }[39m
[31m+   .q-opt.dung { background: var(--dung-nen); border-color: var(--dung); color: var(--dung-muc); font-weight: 700; }[39m
[31m+   .q-opt.dung .q-opt-letter { background: var(--dung); }[39m
[31m+   .tf-badge.d.dung { background: var(--dung-nen); color: var(--dung-muc); border-color: var(--dung); }[39m
[31m+   .tf-badge.s.dung { background: var(--sai-nen); color: var(--sai-muc); border-color: var(--sai); }[39m
[31m+   .sa-blank { display: none; }[39m
[31m+   .sa-answer { display: inline-flex; }[39m
[31m+   .ds-cau { gap: 4mm; }[39m
[31m+[39m
[31m+ }[39m
[31m+[39m
[31m+ /* ================= CHỈ ĐỀ =================[39m
[31m+    Một lớp DUY NHẤT cho cả màn hình lẫn bản in: nút "Hiện đề" bật nó để em đọc[39m
[31m+    đề mà không thấy đáp án, và lệnh in cũng bật đúng lớp này. Trước đây luật[39m
[31m+    chỉ nằm trong @media print nên trên màn hình không có cách nào giấu lời giải[39m
[31m+    — mà đó chính là lúc em cần đọc đề trần nhất (thầy chốt 06/09).[39m
[31m+[39m
[31m+    !important vì luật màn hình cho thẻ đang mở có ĐỘ ƯU TIÊN BẰNG luật này.[39m
[31m+    Thẻ nào đang mở đọc dở lúc bấm là câu đó vẫn tô xanh đáp án. */[39m
[31m+ body.chi-de .sol-wrap { display: none !important; }[39m
[31m+ body.chi-de .q-nut-giai { visibility: hidden; }[39m
[31m+ /* CHƯA NỘP THÌ KHÔNG CÓ LỜI GIẢI (thầy chốt 08/09: "phải nộp xong mới hiện").[39m
[31m+    Mở sẵn lời giải trong lúc em còn đang chọn thì bài luyện thành bài chép, và[39m
[31m+    con số "đúng 7/10" không còn nghĩa gì.[39m
[31m+[39m
[31m+    Giấu bằng CSS chứ không cắt lời giải khỏi tệp: em nộp xong là mở ra ngay,[39m
[31m+    không phải gọi lại máy chủ — phiếu mở từ Zalo hay lúc mất mạng vẫn chạy.[39m
[31m+    Đánh đổi, nói thẳng: ai mở mã nguồn trang vẫn đọc được đáp án. Đây là phiếu[39m
[31m+    tự luyện ở nhà, không phải bài thi có coi. */[39m
[31m+ /* CHƯA NỘP: giấu MỌI đường tới đáp án, không riêng nút trên từng thẻ.[39m
[31m+    Bản đầu chỉ giấu .q-nut-giai và một lớp .q-giai KHÔNG TỒN TẠI (khối lời giải[39m
[31m+    thật tên là .sol-wrap), nên nút "Mở tất cả" ở thanh trên vẫn mở được sạch cả[39m
[31m+    11 câu — thầy bắt được ngay 08/09.[39m
[31m+[39m
[31m+    Bốn đường phải bịt hết:[39m
[31m+      1. nút lời giải trên từng thẻ và khối lời giải;[39m
[31m+      2. nút "Mở tất cả" và "Hiện đề" ở thanh trên (cả hai đều mở đáp án);[39m
[31m+      3. bộ đếm "Đã xem lời giải x/y" — nói ra là có lời giải để xem;[39m
[31m+      4. lựa chọn tải PDF KÈM lời giải.[39m
[31m+    Kèm theo: tô đáp án đúng trên thân câu cũng phải tắt, y như chế độ chi-de,[39m
[31m+    phòng khi một thẻ nào đó lọt vào trạng thái mở.[39m
[31m+    (Cấm dấu huyền ngược trong khối này: cả khối nằm trong một chuỗi mẫu.) */[39m
[31m+ body.chua-nop .q-nut-giai, body.chua-nop .sol-wrap { display: none !important; }[39m
[31m+ body.chua-nop #mo-het, body.chua-nop #chi-de, body.chua-nop #pdf-giai, body.chua-nop .dem-giai { display: none !important; }[39m
[31m+ /* GIẤU ĐÁP ÁN TRƯỚC KHI NỘP — nhưng CHỪA Ô EM ĐANG CHỌN.[39m
[31m+    Đây là nguyên nhân gốc của "lựa chọn A chưa bao giờ bấm được" (thầy chỉ ra[39m
[31m+    08/09). Ô đáp án đúng mang lớp "dung"; ba luật này dùng !important nên đè[39m
[31m+    luôn cả màu của ô ĐANG ĐƯỢC CHỌN, vốn không có !important. Hậu quả: em bấm[39m
[31m+    trúng đáp án đúng thì cú bấm VẪN ĂN (đếm lên, lưu lại) nhưng ô không đổi màu[39m
[31m+    một chút nào — nhìn y như không bấm được, bấm lại lần nữa là bỏ chọn.[39m
[31m+    Ba đợt trước tôi đi sửa tầng sự kiện chạm; sự kiện chưa bao giờ hỏng.[39m
[31m+    SỬA LẠI 08/09 TỐI. Bản trưa dùng :not([aria-checked=true]) để chừa ô đang chọn[39m
[31m+    ra — TẮT luật giấu cho ô đó. Hậu quả: ô đáp án ĐÚNG khi được chọn rơi về style[39m
[31m+    .dung (xanh lá) còn ô sai rơi về style chọn thường (xám), nên em bấm là biết[39m
[31m+    ngay đúng hay sai. Đo trên Chromium: ô đúng rgb(215,250,232), ô sai[39m
[31m+    rgb(239,243,247). Em nhắn thầy đúng chỗ này.[39m
[31m+    Cách đúng không phải TẮT luật giấu mà là ĐÈ LÊN nó: giấu vẫn áp cho mọi ô[39m
[31m+    mang lớp dung, rồi luật "đang chọn" mang !important đặt ngay sau và thắng.[39m
[31m+    Ô nào em chọn cũng ra CÙNG MỘT MÀU, đúng hay sai chưa nói gì.[39m
[31m+    (Cấm dấu huyền ngược trong khối này: cả khối nằm trong một chuỗi mẫu.) */[39m
[31m+ /* 15/09 - BO HAN LOI "TO LAI CHO TRUNG HOA".[39m
[31m+    Ba luat cu o day ve lai o dap an bang mot bo mau KHAC bo mau cua o thuong:[39m
[31m+    nen #f8fafc trong khi o thuong la #ffffff, chu var(--muc-2) trong khi o[39m
[31m+    thuong la var(--muc), va chu cai nen var(--vien-dam) trong khi o thuong la[39m
[31m+    #f1f5f9. Bon cho lech mau la bon cho lo dap an - thay chup duoc 15/09: bam[39m
[31m+    "Hien de" ma o B va o D van khac hen ba o con lai.[39m
[31m+    Khong the va lai cho giong bang tay: them mot thuoc tinh moi vao .q-opt.dung[39m
