[31m+ export async function submitAnswers([39m
[31m+   scriptUrl: string,[39m
[31m+   maCa: string,[39m
[31m+   sbd: string,[39m
[31m+   maDe: string,[39m
[31m+   dapAn: AnswerRecord,[39m
[31m+   integrity: IntegrityLog,[39m
[31m+   lanThu = 1,[39m
[31m+   idThietBi = '',[39m
[31m+   giayCau?: Record<string, number>,[39m
[31m+ ): Promise<{ keyBank: KeyBank | null; congBo: CongBoDiem }> {[39m
[31m+   // THỬ LẠI ĐƯỢC (T5) — và CHỈ vì T4 đã có khoá chống trùng `maCa|sbd|lanThu`.[39m
[31m+   // Trước T4, một lượt nộp hết hạn ở máy em nhưng đã tới nơi ở máy chủ sẽ bị ghi[39m
[31m+   // đè lần nữa; nếu thầy vừa khoá ca giữa hai lượt thì lượt sau ăn 'da_dong' và[39m
[31m+   // em thấy báo lỗi cho một bài ĐÃ NỘP XONG.[39m
[31m+   // CẤT BÀI VÀO MÁY CHỦ MỚI TRƯỚC, rồi mới đi Apps Script.[39m
[31m+   //[39m
[31m+   // Đây chính là chỗ thầy báo treo: cả lớp bấm Nộp trong mười giây cuối, ba[39m
[31m+   // mươi lượt dồn vào một cửa Apps Script xếp hàng theo khoá toàn cục. Ghi vào[39m
[31m+   // D1 xong trước nghĩa là DÙ Apps Script có treo thì bài em VẪN AN TOÀN — bản[39m
[31m+   // đồng bộ ngược sẽ đưa về Sheet sau, không mất chữ nào.[39m
[31m+   //[39m
[31m+   // Vẫn gọi Apps Script sau: điểm và đáp án công bố ngay do bên đó tính.[39m
[31m+   const chMoi = await layCauHinhMayChu()[39m
[31m+   const daCat = await nopMoi(chMoi, maCa, sbd, dapAn, integrity, giayCau)[39m
[31m+[39m
[31m+   // MÁY CHỦ MỚI ĐÃ TRẢ LỜI ĐỦ ⇒ THÔI GỌI APPS SCRIPT.[39m
[31m+   //[39m
[31m+   // Đây là lượt gọi Apps Script CUỐI CÙNG còn sót trong đường của em. Trước[39m
[31m+   // đợt này, bài đã cất vào D1 xong mà vẫn phải gọi sang bên kia chỉ để lấy[39m
[31m+   // `keyBank` và cờ `congBo` — tức mỗi em vẫn nện một lượt vào cái cửa xếp[39m
[31m+   // hàng theo khoá toàn cục, đúng chỗ treo mà cả việc chuyển máy chủ sinh ra[39m
[31m+   // để bỏ.[39m
[31m+   //[39m
[31m+   // ĐỦ nghĩa là: ca KHÔNG công bố điểm (không cần đáp án), hoặc có công bố và[39m
[31m+   // ngân hàng đã nằm sẵn trên máy chủ mới. Thiếu một trong hai thì vẫn đi[39m
[31m+   // đường cũ — em nộp xong nhìn màn trắng còn tệ hơn chậm.[39m
[31m+   if (daCat?.ok) {[39m
[31m+     const cb = String(daCat.congBo ?? '')[39m
[31m+     if (cb === 'khong' || cb === 'ca_lop_xong') return { keyBank: null, congBo: cb as CongBoDiem }[39m
[31m+     if (cb === 'ngay' && daCat.keyBank) return { keyBank: daCat.keyBank as KeyBank, congBo: 'ngay' }[39m
[31m+   }[39m
[31m+[39m
[31m+   try {[39m
[31m+     const result = await postCoThuLai(scriptUrl, { action: 'submit', maCa, sbd, maDe, dapAn, integrity, lanThu, idThietBi, giayCau }, HAN_GIAY_DONG_NGUOI)[39m
[31m+     if (!result.ok) throw new Error(result.error || 'Nộp bài thất bại')[39m
[31m+     return { keyBank: result.keyBank ?? null, congBo: result.congBo ?? (result.keyBank ? 'ngay' : 'khong') }[39m
[31m+   } catch (e) {[39m
[31m+     // Apps Script hỏng NHƯNG máy chủ mới đã nhận bài ⇒ KHÔNG báo lỗi cho em.[39m
[31m+     // Báo đỏ lúc này là em tưởng mất bài và bấm nộp lại — đúng lúc máy chủ đang[39m
[31m+     // quá tải nhất. Bài đã nằm trong D1, thầy kéo về sau.[39m
[31m+     if (daCat?.ok) return { keyBank: null, congBo: 'khong' }[39m
[31m+     throw e[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Chu kỳ máy em tự lưu bài đang làm lên máy chủ. 20 giây: đủ dày để khoá ca[39m
[31m+  * giữa giờ không thổi bay quá một phần tư phút làm bài của em, đủ thưa để 30[39m
[31m+  * máy trong phòng không nện Apps Script (30 em × 3 lần/phút = 90 lần/phút). */[39m
[31m+ export const CHU_KY_LUU_TAM_GIAY = 20[39m
[31m+[39m
[31m+ // ---------------------------------------------------------------------------[39m
[31m+ // GIẢM TẢI MÁY CHỦ TRONG CA THI (05/09, trước ca thi thật)[39m
[31m+ //[39m
[31m+ // ĐO ĐƯỢC: mỗi lệnh gọi Apps Script tốn 1,3 giây chi phí cố định. Một em trong[39m
[31m+ // ca 45 phút bắn 270 lệnh trạng thái (10 giây một lần) + 135 lệnh lưu tạm (20[39m
[31m+ // giây một lần) = 405 lệnh. Ba mươi em là hơn 12.000 lệnh, và tệ hơn: cả lớp[39m
[31m+ // vào thi cùng lúc nên MỌI MÁY ĐẬP CÙNG MỘT NHỊP — cứ 10 giây có 30 lệnh dồn[39m
[31m+ // vào máy chủ một lúc, trong khi Apps Script chỉ chạy được vài chục lệnh đồng[39m
[31m+ // thời.[39m
[31m+ //[39m
[31m+ // Hai cách chữa, đều không đổi giao thức và không đổi thứ thầy nhìn thấy:[39m
[31m+ //[39m
[31m+ //   1. LỆCH PHA. Mỗi máy cộng một khoảng ngẫu nhiên vào chu kỳ, nên ba mươi máy[39m
[31m+ //      trải đều ra thay vì dồn cục.[39m
[31m+ //   2. BỎ NHỊP KHI KHÔNG CÓ GÌ ĐỔI. Em làm 28 câu trong 45 phút thì chỉ có 28[39m
[31m+ //      lần đáp án thật sự đổi — 107 nhịp lưu tạm còn lại đang gửi lại y nguyên[39m
[31m+ //      thứ máy chủ đã có.[39m
[31m+[39m
[31m+ /** Khoảng lệch pha tối đa, tính theo phần của chu kỳ. 0,4 nghĩa là chu kỳ 20[39m
[31m+  * giây rải đều trong 20–28 giây tuỳ máy. */[39m
[31m+ export const LECH_PHA = 0.4[39m
[31m+[39m
[31m+ /** Dù không có gì đổi, vẫn báo trạng thái ít nhất ngần này một lần — thầy phải[39m
[31m+  * biết em còn đang làm chứ không phải đã tắt máy. */[39m
[31m+ export const NHIP_BAO_SONG_GIAY = 60[39m
[31m+[39m
[31m+ /** Chu kỳ đã lệch pha cho MÁY NÀY. Tính một lần rồi giữ nguyên cả ca: đổi mỗi[39m
[31m+  * nhịp thì nhịp lại xô về nhau. */[39m
[31m+ export function chuKyLechPha(giay: number, nn: () => number = Math.random): number {[39m
[31m+   return Math.round(giay * (1 + nn() * LECH_PHA))[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Bản MILI GIÂY của `chuKyLechPha`.[39m
[31m+  *[39m
[31m+  * Phòng chờ hỏi mỗi 3 giây; làm tròn về giây như bản trên chỉ ra 3 hoặc 4 giây,[39m
[31m+  * tức cả lớp vẫn dồn vào hai mốc. Ở nhịp ngắn thì phải rải bằng mili giây.[39m
[31m+  *[39m
[31m+  * Đo 09/09 trước ca thi đông: `trangThaiPhongCho` mất 2,2–3,3 giây một lượt khi[39m
[31m+  * vắng, và 60 lượt CÙNG LÚC vẫn xong hết (0 hỏng, chậm nhất 4,3 giây). Máy chủ[39m
[31m+  * chịu được; thứ cần chữa là nhịp gọi của từng máy, không phải sức máy chủ. */[39m
[31m+ export function chuKyLechPhaMs(ms: number, nn: () => number = Math.random): number {[39m
[31m+   return Math.round(ms * (1 + nn() * LECH_PHA))[39m
[31m+ }[39m
[31m+[39m
[31m+ /**[39m
[31m+  * LƯU TẠM bài đang làm (CATHIVAGOILENBANG mục 1).[39m
[31m+  *[39m
[31m+  * Gọi nền, KHÔNG chặn thao tác của em, KHÔNG hiện lỗi ra màn hình: mất mạng[39m
[31m+  * một nhịp thì bỏ qua nhịp đó, nhịp sau ghi đè đủ. Trả về true khi máy chủ đã[39m
[31m+  * nhận, để chỗ gọi biết mà không phải tự đoán.[39m
[31m+  */[39m
[31m+ export async function luuTam(scriptUrl: string, maCa: string, sbd: string, dapAn: AnswerRecord, giayCau?: Record<string, number>): Promise<boolean> {[39m
[31m+   try {[39m
[31m+     // MÁY CHỦ MỚI TRƯỚC — 135 lượt một em một ca.[39m
[31m+     //[39m
[31m+     // `null` nghĩa là "lượt này không nằm ở máy chủ mới" (em vào thi bằng đường[39m
[31m+     // cũ) hoặc máy chủ mới không với tới được — cả hai đều đi tiếp xuống dưới.[39m
[31m+     const chMoi = await layCauHinhMayChu()[39m
[31m+     const rMoi = await luuTamMoi(chMoi, maCa, sbd, dapAn, giayCau)[39m
[31m+     if (rMoi !== null) return rMoi[39m
[31m+[39m
[31m+     // Lưu tạm ghi ĐÈ đúng một dòng bằng đúng nội dung ấy, nên gửi lại vô hại.[39m
[31m+     // Chỉ thử THÊM MỘT lần: nhịp sau còn tới, không việc gì phải cố.[39m
[31m+     const r = await postCoThuLai(scriptUrl, { action: 'luuTam', maCa, sbd, dapAn, giayCau }, HAN_GIAY, 2)[39m
[31m+     return !!r?.ok[39m
[31m+   } catch {[39m
[31m+     return false[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Thầy KHOÁ CA giữa giờ. Trả về số em đang làm bị nộp bài — để màn hình báo[39m
[31m+  * đúng con số thật chứ không nói chung chung. */[39m
[31m+ export async function khoaCa(scriptUrl: string, secret: string, maCa: string, khoaBoi = 'thầy'): Promise<{ soEmBiNop: number; khoaLuc: string }> {[39m
[31m+   const r = await postJson(scriptUrl, { action: 'khoaCa', secret, maCa, khoaBoi })[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không khoá được ca')[39m
[31m+   // Khoá ca bên Apps Script NỘP HỘ mọi em đang làm. Không soi phần ấy sang D1[39m
[31m+   // thì màn Ca thi (đếm từ D1) hiện 4/29 nộp trong khi thật là 29/29.[39m
[31m+   await soiCaSangMayChuMoi(secret, maCa, { trangThai: String(r.trangThai || 'dong') }, { khoaLuot: true })[39m
[31m+   // Danh sách ca vừa đổi — bỏ đệm để lượt hỏi tiếp theo thấy ngay.[39m
[31m+   xoaBoDemCa()[39m
[31m+   return { soEmBiNop: Number(r.soEmBiNop) || 0, khoaLuc: String(r.khoaLuc || '') }[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Thầy MỞ CA LẠI. Em đã bị nộp do khoá KHÔNG tự vào lại được — phải duyệt[39m
[31m+  * thi lại từng em, đúng như mọi trường hợp thi lại khác. */[39m
[31m+ /** MỞ CA: gỡ khoá thủ công VÀ gỡ hạn vào phòng, để em đến muộn vào được ngay.[39m
[31m+  * `goHanVao` = true khi ca có hạn vào và hạn đó vừa bị gỡ. */[39m
[31m+ export async function moKhoaCa(scriptUrl: string, secret: string, maCa: string): Promise<{ goHanVao: boolean }> {[39m
[31m+   const r = await postJson(scriptUrl, { action: 'moKhoaCa', secret, maCa })[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không mở lại được ca')[39m
