[31m+       if (coKhoa(muc, 'dau_vet_chup')) khoaVi('dau_vet_chup', `${t.length} ngón chạm cùng lúc`)[39m
[31m+     }[39m
[31m+     document.addEventListener('touchstart', demNgon, { passive: true })[39m
[31m+     document.addEventListener('touchmove', demNgon, { passive: true })[39m
[31m+[39m
[31m+     // ---- CÁCH 2 (CHE ĐỀ KHI BẤT ĐỘNG) ĐÃ GỠ 06/09 theo lệnh của thầy.[39m
[31m+     // Video ca 06/09: em Tuân bị che đề ba lần trong 23 giây chỉ vì đang đọc.[39m
[31m+     // Đề nay hiện suốt giờ làm bài. Lý do đầy đủ ở `man-thi-sach.ts`.[39m
[31m+[39m
[31m+     // NHỊP SOI TIÊU ĐIỂM — đây là chỗ bắt CỬA SỔ NỔI, kiểu gian lận thầy quay[39m
[31m+     // video ngày 05/09: em mở cửa sổ nổi Gemini đè lên bài rồi đưa ảnh chụp vào[39m
[31m+     // hỏi. Lúc đó Chrome mất tiêu điểm nhưng trang VẪN HIỆN — không sự kiện[39m
