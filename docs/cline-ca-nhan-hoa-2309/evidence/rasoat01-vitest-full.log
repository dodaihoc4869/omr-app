[31m+ // ---------------------------------------------------------------------------[39m
[31m+[39m
[31m+ /** Mã phiếu 10 ký tự trên bảng chữ 56 ký tự — khoảng 58 bit ngẫu nhiên.[39m
[31m+  *[39m
[31m+  * Vì sao đúng 10: link phải NGẮN NHẤT CÓ THỂ để dán vào Zalo cho gọn, mà vẫn[39m
[31m+  * không dò ra được. 56^10 ≈ 3·10^17 tổ hợp; kho có 10.000 phiếu thì mỗi lần[39m
[31m+  * đoán bừa trúng với xác suất 3·10^-14, và Apps Script còn chặn gọi dồn. Ngắn[39m
[31m+  * hơn nữa thì bắt đầu đáng lo, dài hơn chỉ tổ dài link.[39m
[31m+  *[39m
[31m+  * Bỏ 0 O 1 I l khỏi bảng chữ để thầy đọc mã qua điện thoại không bị nhầm. */[39m
[31m+ export function sinhMaPhieu(): string {[39m
[31m+   const chu = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789'[39m
[31m+   const b = new Uint8Array(10)[39m
[31m+   crypto.getRandomValues(b)[39m
[31m+   let s = ''[39m
[31m+   for (const x of b) s += chu[x % chu.length][39m
[31m+   return s[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Gói phiếu lớn nhất còn gửi lên máy chủ được, tính bằng byte.[39m
[31m+  *[39m
[31m+  * Phiếu nhúng thẳng ảnh cắt từ đề dưới dạng data URL, nên một ca nhiều hình có[39m
[31m+  * thể phình lên vài MB. Apps Script cắt nhỏ rồi cất vào ô của Sheet, quá cỡ là[39m
[31m+  * nó nghẹn giữa chừng và trả lỗi khó hiểu — chặn ngay tại máy, báo đúng việc[39m
[31m+  * thầy phải làm, hơn là để thầy ngồi chờ rồi nhận lỗi lạ. */[39m
[31m+ const CO_TOI_DA_PHIEU = 4 * 1024 * 1024[39m
[31m+[39m
[31m+ /** Loại phiếu: kết quả bài kiểm tra, hay bài tập giao về nhà. Một em trong một[39m
[31m+  * ca có thể có cả hai, mà gửi Zalo thì phải gửi đúng loại. */[39m
[31m+ export type LoaiPhieu = 'ketqua' | 'baitap'[39m
[31m+[39m
[31m+ /** HỒ SƠ NHIỀU EM MỘT LƯỢT — dùng khi dựng phiếu cả ca.[39m
[31m+  *[39m
[31m+  * Gọi `hoSoEm` từng em thì máy chủ đọc trọn ba sheet cho MỖI em; ca ba chục em[39m
[31m+  * là chín chục lượt đọc cùng một nội dung. Lệnh này đọc một lần rồi tính cho[39m
[31m+  * cả danh sách. */[39m
[31m+ export async function hoSoNhieuEm(scriptUrl: string, secret: string, sbd: string[]): Promise<HoSoEm[]> {[39m
[31m+   if (sbd.length === 0) return [][39m
[31m+   const r = await postJson(scriptUrl, { action: 'hoSoNhieuEm', secret, sbd }, 90)[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không lấy được hồ sơ')[39m
[31m+   return (Array.isArray(r.items) ? r.items : []) as HoSoEm[][39m
[31m+ }[39m
[31m+[39m
[31m+ export interface PhieuCanLuu {[39m
[31m+   ma: string[39m
[31m+   maCa: string[39m
[31m+   sbd: string[39m
[31m+   hoTen: string[39m
[31m+   phieu: unknown[39m
[31m+   loai?: LoaiPhieu[39m
[31m+ }[39m
[31m+[39m
[31m+ /** Số phiếu tối đa một gói — khớp `TRAN_PHIEU_MOT_GOI` bên máy chủ. */[39m
[31m+ export const TRAN_PHIEU_MOT_GOI = 6[39m
[31m+[39m
[31m+ /** LƯU NHIỀU PHIẾU MỘT LƯỢT. Tự chia gói, tự bỏ phiếu quá cỡ (nặng vì nhiều[39m
[31m+  * hình) và báo lại — một em quá cỡ không được kéo theo cả ca không có link. */[39m
[31m+ export async function luuNhieuPhieu([39m
[31m+   scriptUrl: string,[39m
[31m+   secret: string,[39m
[31m+   ds: PhieuCanLuu[],[39m
[31m+ ): Promise<{ daLuu: { sbd: string; ma: string }[]; loi: { sbd: string; vi_sao: string }[] }> {[39m
[31m+   const daLuu: { sbd: string; ma: string }[] = [][39m
[31m+   const loi: { sbd: string; vi_sao: string }[] = [][39m
[31m+   const vua: PhieuCanLuu[] = [][39m
[31m+   for (const p of ds) {[39m
[31m+     const co = new Blob([JSON.stringify(p.phieu)]).size[39m
[31m+     if (co > CO_TOI_DA_PHIEU) {[39m
[31m+       loi.push({ sbd: p.sbd, vi_sao: `Phiếu nặng ${(co / 1024 / 1024).toFixed(1)} MB vì nhiều hình, quá cỡ gửi bằng link` })[39m
[31m+       continue[39m
[31m+     }[39m
[31m+     vua.push(p)[39m
[31m+   }[39m
[31m+   for (let i = 0; i < vua.length; i += TRAN_PHIEU_MOT_GOI) {[39m
[31m+     const goi = vua.slice(i, i + TRAN_PHIEU_MOT_GOI).map((p) => ({ ...p, loai: p.loai || 'ketqua' }))[39m
[31m+     const r = await postJson(scriptUrl, { action: 'luuNhieuPhieu', secret, items: goi }, 120)[39m
[31m+     if (!r.ok) throw new Error(r.error || 'Không lưu được phiếu')[39m
[31m+     for (const x of r.daLuu || []) daLuu.push({ sbd: String(x.sbd), ma: String(x.ma) })[39m
[31m+     for (const x of r.loi || []) loi.push({ sbd: String(x.sbd), vi_sao: String(x.vi_sao) })[39m
[31m+   }[39m
[31m+   return { daLuu, loi }[39m
[31m+ }[39m
[31m+[39m
[31m+ export async function luuPhieu(scriptUrl: string, secret: string, d: { ma: string; maCa: string; sbd: string; hoTen: string; phieu: unknown; loai?: LoaiPhieu }): Promise<void> {[39m
[31m+   const co = new Blob([JSON.stringify(d.phieu)]).size[39m
[31m+   if (co > CO_TOI_DA_PHIEU) {[39m
[31m+     throw new Error([39m
[31m+       `Phiếu này nặng ${(co / 1024 / 1024).toFixed(1)} MB vì nhiều hình, quá cỡ gửi bằng link. Thầy bấm Xem phiếu rồi dùng nút Tải tệp, gửi thẳng tệp qua Zalo.`,[39m
[31m+     )[39m
[31m+   }[39m
[31m+   // Gói nặng nên cho hạn rộng hơn mặc định: 4 MB qua 4G có khi mất cả phút.[39m
[31m+   // `loai` đặt SAU `...d`: để trước thì `...d` rải đè lại bằng undefined khi chỗ[39m
[31m+   // gọi không truyền, và máy chủ nhận rỗng.[39m
[31m+   // MÁY CHỦ MỚI TRƯỚC — phụ huynh mở link sẽ đọc từ đây, nhanh hơn ~30 lần.[39m
[31m+   // Hỏng thì BỎ QUA: đây là đường tắt, không phải nghĩa vụ. Phiếu vẫn lưu như[39m
[31m+   // hôm nay ở dòng dưới, chỉ là mở chậm hơn.[39m
[31m+   try {[39m
[31m+     const chMoi = await layCauHinhMayChu()[39m
[31m+     await dayPhieuMoi(chMoi, secret, { ma: d.ma, maCa: d.maCa, sbd: d.sbd, hoTen: d.hoTen, loai: d.loai || 'ketqua', phieu: d.phieu })[39m
[31m+   } catch {[39m
[31m+     // không chặn việc lưu vì một đường tắt[39m
[31m+   }[39m
[31m+[39m
[31m+   // APPS SCRIPT VẪN LÀ NGUỒN SỰ THẬT. Chỉ dòng này được phép ném lỗi: lưu hỏng[39m
[31m+   // ở đây mới thật sự là chưa có phiếu.[39m
[31m+   const r = await postJson(scriptUrl, { action: 'luuPhieu', secret, ...d, loai: d.loai || 'ketqua' }, 90)[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không lưu được phiếu')[39m
[31m+ }[39m
[31m+[39m
[31m+ /** HẠN CHỜ CỦA PHỤ HUYNH. Bằng đúng hạn của `luuPhieu` — hai đầu cùng một gói.[39m
[31m+  *[39m
[31m+  * Thầy báo 10/09 lúc 22:05, kèm ảnh màn phụ huynh: "Không mở được báo cáo —[39m
[31m+  * Máy chủ không trả lời sau 25 giây."[39m
[31m+  *[39m
[31m+  * Hai chỗ lệch nhau, và cái thứ hai mới là gốc:[39m
[31m+  *[39m
[31m+  *   1. Bên GHI (`luuPhieu`) đã cho 90 giây với đúng lý do "gói nặng, 4 MB qua[39m
[31m+  *      4G có khi mất cả phút" — mà bên ĐỌC lại chỉ được 25 giây mặc định cho[39m
[31m+  *      CHÍNH cái gói ấy. Phiếu ca 890691 nặng 176 KB, phiếu có hình còn nặng[39m
[31m+  *      hơn nhiều.[39m
[31m+  *   2. Apps Script khoá theo script, tức TOÀN CỤC: một ca đang nộp bài là mọi[39m
[31m+  *      lệnh khác xếp hàng phía sau. Đo tối 10/09, lúc 14 em ca 817428 đang nộp:[39m
[31m+  *      `danhSachCa` — lệnh đọc nhẹ nhất trong app — cũng quá 25 giây rồi hỏng.[39m
[31m+  *      Phụ huynh mở link đúng vào lúc ấy thì không có cách nào kịp.[39m
[31m+  *[39m
[31m+  * Với phụ huynh, chờ thêm nửa phút vẫn hơn hẳn một câu báo lỗi: họ bấm link[39m
[31m+  * trong Zalo đúng một lần rồi thôi. */[39m
[31m+ const HAN_GIAY_LAY_PHIEU = 90[39m
[31m+[39m
[31m+ /** Chờ giữa hai lượt, đủ để lượt đang tắc trên máy chủ chạy xong. */[39m
[31m+ const CHO_THU_LAI_MS = 2500[39m
[31m+[39m
[31m+ export async function layPhieu(scriptUrl: string, ma: string): Promise<unknown> {[39m
[31m+   // MÁY CHỦ MỚI TRƯỚC. Đo đường cũ sau khi đã tối ưu: p50 5,13 s · p95 5,85 s —[39m
[31m+   // phụ huynh bấm link rồi ngồi nhìn năm giây. R2 trả cùng gói ấy trong vài[39m
[31m+   // trăm mili giây.[39m
[31m+   //[39m
[31m+   // `null` nghĩa là "hỏi chỗ cũ", dùng chung cho cả ba ca: cờ tắt · phiếu tạo[39m
[31m+   // trước hôm nay nên chỉ có bên Apps Script · mạng hỏng. Không ca nào được[39m
[31m+   // biến thành báo đỏ cho phụ huynh.[39m
[31m+   try {[39m
[31m+     // Máy phụ huynh mở link LẦN ĐẦU: địa chỉ máy chủ mới đang được nạp ở[39m
[31m+     // `main.tsx` ngay lúc này. Không chờ nó xong thì lượt đọc dưới đây thấy cấu[39m
[31m+     // hình rỗng và rơi thẳng về Apps Script — mất trắng cả việc chuyển phiếu[39m
[31m+     // sang R2. Tệp cấu hình cùng gốc và đã nằm trong đệm, chờ là vài mili giây.[39m
[31m+     await xongNapDiaChi()[39m
[31m+     const chMoi = await layCauHinhMayChu()[39m
[31m+     const nhanh = await layPhieuMoi(chMoi, ma)[39m
[31m+     if (nhanh !== null && nhanh !== undefined) return nhanh[39m
[31m+   } catch {[39m
[31m+     // rơi xuống đường cũ[39m
[31m+   }[39m
[31m+[39m
[31m+   let cuoi: unknown = null[39m
[31m+   // THỬ LẠI ĐÚNG MỘT LƯỢT, và CHỈ khi hỏng vì mạng hoặc hết hạn chờ. Máy chủ[39m
[31m+   // trả lời "không có phiếu" là một CÂU TRẢ LỜI (thầy đã thu hồi link) — báo[39m
[31m+   // ngay, không bắt phụ huynh ngồi chờ thêm 90 giây nữa cho một kết cục đã biết.[39m
[31m+   for (let lan = 0; lan < 2; lan++) {[39m
[31m+     try {[39m
[31m+       const r = await postJson(scriptUrl, { action: 'layPhieu', ma }, HAN_GIAY_LAY_PHIEU)[39m
[31m+       if (r.ok) return r.phieu[39m
[31m+       throw new Error(r.error || 'Không tìm thấy phiếu')[39m
[31m+     } catch (e) {[39m
[31m+       cuoi = e[39m
[31m+       if (e instanceof Error && e.message.includes('Không tìm thấy phiếu')) throw e[39m
[31m+       if (lan === 0) await new Promise((nghi) => setTimeout(nghi, CHO_THU_LAI_MS))[39m
[31m+     }[39m
[31m+   }[39m
[31m+   throw cuoi instanceof Error ? cuoi : new Error('Không mở được báo cáo')[39m
[31m+ }[39m
[31m+[39m
[31m+ // ------------------------------------------------- NỘP PHIẾU KHẮC PHỤC[39m
[31m+ // NOP-PHIEU-KHAC-PHUC.md. Lệnh nộp là lệnh GHI CÔNG KHAI: em chỉ có cái link,[39m
[31m+ // không có mã bí mật. Máy chủ tự chấm lại nên con số trả về là con số ĐÃ GHI,[39m
[31m+ // không phải con số máy em tính.[39m
[31m+[39m
[31m+ export interface KetQuaNopKhacPhuc {[39m
[31m+   lanThu: number[39m
[31m+   soCau: number[39m
[31m+   soDung: number[39m
[31m+   qidSai: string[][39m
[31m+   nopLuc: string[39m
[31m+ }[39m
[31m+[39m
[31m+ export async function nopKhacPhuc(scriptUrl: string, ma: string, sbd: string, dapAn: Record<string, string>): Promise<KetQuaNopKhacPhuc> {[39m
[31m+   const r = await postJson(scriptUrl, { action: 'nopKhacPhuc', ma, sbd, dapAn })[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không nộp được bài')[39m
[31m+   return {[39m
[31m+     lanThu: Number(r.lanThu) || 1,[39m
[31m+     soCau: Number(r.soCau) || 0,[39m
[31m+     soDung: Number(r.soDung) || 0,[39m
[31m+     qidSai: Array.isArray(r.qidSai) ? (r.qidSai as string[]).map(chuoi) : [],[39m
[31m+     nopLuc: chuoi(r.nopLuc),[39m
[31m+   }[39m
[31m+ }[39m
[31m+[39m
