[31m+   })[39m
[31m+   // Danh sách ca vừa đổi — bỏ đệm để lượt hỏi tiếp theo thấy ngay.[39m
[31m+   xoaBoDemCa()[39m
[31m+   return { goHanVao: !!(r as { goHanVao?: boolean }).goHanVao }[39m
[31m+ }[39m
[31m+[39m
[31m+ export interface KetQuaDongBoTenCa {[39m
[31m+   maCa: string[39m
[31m+   tenCa: string[39m
[31m+   /** Lượt đang bỏ trống tên, nay điền từ danh sách lớp. */[39m
[31m+   daDien: { sbd: string; hoTen: string }[][39m
