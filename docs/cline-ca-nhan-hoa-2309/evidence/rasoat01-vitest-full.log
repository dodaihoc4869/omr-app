[31m+     //[39m
[31m+     // KHÔNG áp cho máy cảm ứng: iOS không cho phần tử vào toàn màn hình thật,[39m
[31m+     // nên `dangToanManHinh()` luôn false và mỗi lần sự kiện bắn là một lần[39m
[31m+     // "rời màn" bịa ra. Trên iPhone `hidden` đã đủ bắt em thoát app.[39m
[31m+     const onFs = () => {[39m
[31m+       if (camUng) return[39m
[31m+       logEvent(dangToanManHinh() ? 'focus' : 'hidden')[39m
