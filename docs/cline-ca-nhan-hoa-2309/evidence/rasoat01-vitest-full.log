[31m+[39m
[31m+ /* ================= Ô LÀM BÀI (phiếu nộp được) =================[39m
[31m+    CHỌN NGAY TRÊN PHƯƠNG ÁN, không có hàng "EM CHỌN" riêng nữa (thầy chốt[39m
[31m+    08/09). Hàng phương án của đề vốn đã cao hơn 44px nên cỡ chạm đã đạt; ở đây[39m
[31m+    chỉ thêm con trỏ, viền chọn và trạng thái. */[39m
[31m+ /* Ô CHỌN LÀ THẺ <button> THẬT. Reset dáng mặc định của nút để hình y hệt bản[39m
[31m+    chỉ đọc, nhưng vẫn là nút với trình duyệt — đó mới là thứ làm cú chạm ăn. */[39m
[31m+ button.lam-o {[39m
[31m+   appearance: none; -webkit-appearance: none;[39m
[31m+   font: inherit; text-align: left; margin: 0;[39m
[31m+ }[39m
[31m+ .lam-o {[39m
[31m+   cursor: pointer; -webkit-tap-highlight-color: transparent;[39m
[31m+   /* KHÔNG CHỜ CHẠM ĐÚP: thiếu dòng này thì trình duyệt di động giữ chạm lại[39m
[31m+      khoảng 300ms để xem có phải chạm đúp không, và em thấy nút "lì". */[39m
[31m+   touch-action: manipulation;[39m
[31m+   /* Chạm giữ lâu không được bôi đen chữ trong ô — bôi đen xong thì cú chạm[39m
[31m+      tính là chọn chữ, không tính là bấm. */[39m
[31m+   -webkit-user-select: none; user-select: none;[39m
[31m+ }[39m
[31m+ /* Ô Đ/S TO BẰNG NGÓN TAY khi phiếu cho làm bài (thầy bắt được 08/09: "nút Đ[39m
[31m+    bấm mãi không được"). Ô cũ 34x30 — dưới ngưỡng 44px, lại đứng cách nhau 10px[39m
[31m+    nên ngón tay rơi vào khe giữa hai ô là mất cú bấm.[39m
[31m+    CHỈ áp cho phiếu làm bài: phiếu đọc và bản in giữ nguyên khổ cũ. */[39m
[31m+ body.co-lam .tf-badge { width: 46px; height: 44px; border-radius: 10px; font-size: 15px; position: relative; }[39m
[31m+ /* VÙNG CHẠM RỘNG HƠN Ô NHÌN THẤY. Đo trên Chromium có cảm ứng: tay xê ngang[39m
[31m+    18px là đã rơi ra rìa ô 46px và mất cú bấm. Nới thêm 6px mỗi phía cho ngón[39m
[31m+    tay, giao diện KHÔNG đổi. Đúng 6px vì hai ô cách nhau 12px — rộng hơn nữa là[39m
[31m+    hai vùng chạm chồng lên nhau, bấm Đ lại ăn sang S. */[39m
[31m+ body.co-lam .tf-badge.lam-o::after { content: ''; position: absolute; inset: -6px; border-radius: 14px; }[39m
[31m+ body.co-lam .tf-o { gap: 12px; }[39m
[31m+ body.co-lam .tf-item { padding: 9px 10px; }[39m
[31m+ .q-opt.lam-o { transition: background-color .12s, border-color .12s; }[39m
[31m+ .q-opt.lam-o[aria-checked="true"] { background: var(--chon-nen); border-color: var(--chon-vien); }[39m
[31m+ .q-opt.lam-o[aria-checked="true"] .q-opt-letter { background: #2f3e46; color: #ffffff; }[39m
[31m+ .tf-badge.lam-o { transition: background-color .12s, border-color .12s, color .12s; }[39m
[31m+ .tf-badge.lam-o[aria-checked="true"] { background: #2f3e46; border-color: #2f3e46; color: #ffffff; }[39m
[31m+ .lam-o:focus-visible { outline: 3px solid rgba(47,62,70,.35); outline-offset: 2px; }[39m
[31m+ .lam-nhap {[39m
[31m+   width: 100%; max-width: 260px; height: 40px; border-radius: 10px; border: 1px solid #e4e0d7;[39m
[31m+   padding: 0 14px; font: inherit; font-size: 14px; color: var(--muc); background: var(--o-nen);[39m
[31m+ }[39m
[31m+ .lam-nhap:focus { outline: none; border-color: #2f3e46; }[39m
[31m+ /* Hai nút "−" và "," cạnh ô trả lời ngắn: bàn phím SỐ của điện thoại không có hai dấu ấy. Không lấy tiêu điểm khỏi ô (bàn phím không đóng). */[39m
[31m+ .lam-nhap-khoi { display: flex; align-items: stretch; gap: 8px; width: 100%; max-width: 340px; }[39m
[31m+ .lam-nhap-khoi .lam-nhap { flex: 1 1 auto; min-width: 0; max-width: none; }[39m
[31m+ .lam-nut { flex: 0 0 auto; min-width: 44px; height: 40px; padding: 0 10px; border-radius: 10px; border: 1px solid #e4e0d7; background: var(--o-nen); color: var(--muc); font: inherit; font-size: 20px; font-weight: 700; line-height: 1; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; user-select: none; }[39m
[31m+ .lam-nut:focus-visible { outline: 3px solid rgba(47,62,70,.35); outline-offset: 2px; }[39m
[31m+ .q-card.da-cham .lam-nut { pointer-events: none; opacity: .5; }[39m
[31m+ /* Sau khi nộp: khoá ô lại và tô đúng/sai. Màu KHÔNG đứng một mình — mỗi thẻ[39m
[31m+    mang thêm dòng chữ "Đúng"/"Sai" ngay dưới. */[39m
[31m+ .q-card.da-cham .lam-o, .q-card.da-cham .lam-nhap { pointer-events: none; opacity: .95; }[39m
[31m+ .lam-ket { margin-top: 8px; font-size: 13px; font-weight: 700; }[39m
[31m+ .q-card.cau-dung .lam-ket { color: #2e8b6b; }[39m
[31m+ .q-card.cau-sai .lam-ket { color: #b42318; }[39m
[31m+[39m
[31m+ /* Thanh nộp và dải kết quả. */[39m
[31m+ .nop-chu { flex: 1; min-width: 0; font-size: 12.5px; color: var(--muc-2); }[39m
[31m+ .nut.nop { background: #16171a; color: #ffffff; }[39m
