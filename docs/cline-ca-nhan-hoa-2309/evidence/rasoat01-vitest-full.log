[31m+ // CÂU KHẮC PHỤC RÚT TỪ KHO ĐỀ (thầy chốt 06/09)[39m
[31m+[39m
[31m+ export interface KetQuaKhacPhuc {[39m
[31m+   /** Từng đề gốc một khối, GIỮ NGUYÊN `ma_de` để mã câu không đụng nhau: hai[39m
