[31m+           if (kq.khoa && !conAnHan() && khoaDuocViThuNhoMan(camUngMay) && coKhoa(muc, 'thu_nho_man')) khoaVi('thu_nho_man', 'kênh 4')[39m
[31m+           return[39m
[31m+         }[39m
[31m+[39m
[31m+         // --- KÊNH 7: phím chụp trên máy tính. Một mình đủ để khoá.[39m
[31m+         if (p.kenh === 'phim_chup') {[39m
[31m+           if (!conAnHan() && coKhoa(muc, 'dau_vet_chup')) khoaVi('dau_vet_chup', 'kênh 7')[39m
[31m+           return[39m
[31m+         }[39m
[31m+[39m
[31m+         // --- KÊNH 1 và 2: ra khỏi màn. Che ngay, phân loại sau (mục 4.1).[39m
[31m+         if (p.kenh === 'an_trang' || p.kenh === 'tieu_diem') {[39m
[31m+           const veLai = (p.kenh === 'an_trang' && bc.hienTrang) || (p.kenh === 'tieu_diem' && bc.coTieuDiem)[39m
[31m+           if (veLai) {[39m
[31m+             if (raTu !== null && p.luc - raTu < MS_VE_SOM) xetPhieu(p) // ra rồi về ngay: ghi sổ[39m
[31m+             raTu = null[39m
[31m+             if (henNoi) window.clearTimeout(henNoi)[39m
[31m+             boChe()[39m
[31m+             return[39m
[31m+           }[39m
[31m+           che('Bài thi tạm ẩn khi màn hình bị che. Quay lại để làm tiếp.')[39m
[31m+           if (raTu === null) {[39m
[31m+             raTu = p.luc[39m
[31m+             // Nhịp 900 ms: chờ `hidden` báo trễ của iOS. Bỏ nhịp này là mọi[39m
[31m+             // cuộc gọi đến thành cửa sổ nổi → khoá ngay.[39m
[31m+             if (henNoi) window.clearTimeout(henNoi)[39m
[31m+             henNoi = window.setTimeout(() => {[39m
[31m+               if (daKhoa || raTu === null) return[39m
