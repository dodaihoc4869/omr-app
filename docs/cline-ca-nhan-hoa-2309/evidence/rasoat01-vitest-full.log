[31m+ /** Mọi lượt nộp khắc phục của một ca. Cần mã bí mật — chỉ thầy đọc. */[39m
[31m+ export async function nopKhacPhucTheoCa(scriptUrl: string, secret: string, maCa: string): Promise<LuotNopKhacPhuc[]> {[39m
[31m+   const r = await postJson(scriptUrl, { action: 'nopKhacPhucTheoCa', secret, maCa })[39m
