[31m+ export async function trangThaiPhongCho(scriptUrl: string, maCa: string): Promise<TrangThaiPhongCho> {[39m
[31m+   // MỘT LƯỢT HỎI, KHÔNG ĐỐI CHIẾU. Cả lớp đứng chờ và hỏi lại mỗi ba giây —[39m
