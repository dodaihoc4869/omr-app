[31m+  * điền vào lượt thi và vào hồ sơ em nếu hồ sơ đang trống.[39m
[31m+  *[39m
[31m+  * Không đụng điểm, đáp án hay chi tiết câu. Dựng lại phiếu sau khi chạy là tên[39m
[31m+  * hiện đúng. */[39m
[31m+ export async function dongBoTenCa(scriptUrl: string, secret: string, maCa: string): Promise<KetQuaDongBoTenCa> {[39m
[31m+   const r = await postJson(scriptUrl, { action: 'dongBoTenCa', secret, maCa })[39m
[31m+   if (!r.ok) throw new Error(r.error || 'Không đồng bộ được tên')[39m
[31m+   return {[39m
[31m+     maCa: String(r.maCa || maCa),[39m
[31m+     tenCa: String(r.tenCa || ''),[39m
[31m+     daDien: Array.isArray(r.daDien) ? (r.daDien as KetQuaDongBoTenCa['daDien']) : [],[39m
