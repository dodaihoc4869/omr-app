[31m+       const events = [...cur.integrity.events, { type: 'khoa' as const, at: new Date().toISOString() }].slice(-200)[39m
[31m+       const next: ExamAttempt = { ...cur, integrity: { ...cur.integrity, events, blocked: true, lyDoKhoa: lyDo, kenhBao } }[39m
[31m+       attemptRef.current = next[39m
[31m+       setAttempt(next)[39m
[31m+       saveAttempt(next)[39m
[31m+       pushStatusNow(next, false)[39m
[31m+       baoThayGianLan(next)[39m
[31m+       void doSubmit(next)[39m
[31m+     }[39m
[31m+[39m
[31m+     /** Một phiếu vừa tới. **KHÔNG KHOÁ AI** — chỉ giữ lại trong cửa sổ trượt để[39m
[31m+      * ghi bối cảnh vào nhật ký của thầy.[39m
[31m+      *[39m
[31m+      * Bản trước có hai đường dẫn tới khoá từ đây: đủ hai họ trùng khớp, và một[39m
[31m+      * phiếu họ luồng-chính khi không ai chạm màn. Cả hai đã gỡ 06/09 — lý do[39m
[31m+      * đầy đủ nằm ở khối "LUỒNG CHÍNH NGHẼN KHÔNG CÒN ĐƯỢC KHOÁ" trong[39m
[31m+      * `man-thi-sach.ts`. Tóm tắt: đó là suy đoán từ độ nghẽn của máy, mà máy[39m
[31m+      * nghẽn vì trăm thứ không phải gian lận, và điều kiện "không chạm màn" bắt[39m
[31m+      * đúng vào em đang ngồi đọc đề.[39m
[31m+      *[39m
[31m+      * `phieuDuocKhoa` là cửa duy nhất còn lại: chỉ họ `do_truc_tiep`. Kênh 5, 6,[39m
[31m+      * 8 rơi vào đây thì dừng ở dòng ghi sổ. */[39m
[31m+     const xetPhieu = (p: PhieuKenh) => {[39m
[31m+       phieu.push(p)[39m
[31m+       while (phieu.length && phieu[0].luc < p.luc - MS_TRUNG_KHOP * 2) phieu.shift()[39m
[31m+     }[39m
[31m+[39m
[31m+     // ---- CÁCH 1: ĐẾM SỐ NGÓN CHẠM.[39m
[31m+     // Chụp màn hình bằng cử chỉ trên Android là vuốt BA NGÓN, và trang nhận đủ[39m
[31m+     // ba điểm chạm. Em làm bài chạm một ngón để chọn đáp án, hai ngón để phóng[39m
[31m+     // ảnh — không bao giờ ba. Tín hiệu trực tiếp, không ngưỡng nào phải đo.[39m
[31m+     //[39m
[31m+     // Sau 06/09 đây là ĐƯỜNG DUY NHẤT còn khoá được vì dấu vết chụp trên điện[39m
