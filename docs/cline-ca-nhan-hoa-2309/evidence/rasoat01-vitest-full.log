[31m+   | 'het_han_vao'[39m
[31m+   | 'het_gio_chung'[39m
[31m+   | 'chua_co_ho_so'[39m
[31m+   | 'khong_thuoc_khoi'[39m
[31m+   | 'khong_trong_danh_sach'[39m
[31m+   | 'sai_ho_so'[39m
[31m+   /** Thầy cho thi lại và khoá theo máy cũ; em đang mở ở máy khác. */[39m
