[31m+ /** Ghi điểm + chi tiết từng câu cho nhiều lượt trong 1 lần gọi (máy thầy: secret;[39m
[31m+  * máy em: secret rỗng + idThietBi của lượt). Trả về SBD đã ghi / bị từ chối. */[39m
[31m+ export async function ghiDiem([39m
[31m+   scriptUrl: string,[39m
[31m+   secret: string,[39m
[31m+   maCa: string,[39m
[31m+   bai: BaiGhiDiem[],[39m
[31m+   /** MẪU SỐ đã dùng để chấm lô này — số câu mỗi phần của ca.[39m
[31m+    *[39m
