[31m+       if (!conAnHan() && coKhoa(muc, 'cua_so_noi', soLanNoi)) khoaVi('cua_so_noi', 'nhịp soi tiêu điểm')[39m
[31m+     }, MS_NHIP_SOI_TIEU_DIEM)[39m
[31m+[39m
[31m+     const go = thuTinHieu({[39m
[31m+       onPhieu: (p, bc) => {[39m
[31m+         if (daKhoa) return[39m
[31m+[39m
[31m+         // --- KÊNH 3: thoát toàn màn hình. Số đo trực tiếp, khoá một mình.[39m
