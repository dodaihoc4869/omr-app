[31m+   background: var(--nen); border: 1px solid var(--vien); border-radius: 14px;[39m
[31m+ }[39m
[31m+ .cover-info-label { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: var(--nhat); margin-bottom: 3px; }[39m
[31m+ .cover-info-value { font-size: clamp(13.5px, 3.2vw, 15.5px); font-weight: 700; overflow-wrap: anywhere; line-height: 1.35; }[39m
[31m+[39m
[31m+ /* ================= TỔNG QUAN ================= */[39m
[31m+ /* TỔNG QUAN — cùng lối phẳng sáng với bìa.[39m
[31m+    Bỏ luôn lề trên âm: khối này chồng đè lên bìa chỉ có nghĩa khi hai khối[39m
[31m+    khác màu nhau. Cùng nền sáng thì chồng lên nhau thành một mảng rối, nên nay[39m
[31m+    xếp cách đều. */[39m
[31m+ .summary-page {[39m
[31m+   margin: 0 auto 20px; max-width: 900px; position: relative; z-index: 3;[39m
[31m+   border-radius: 28px; padding: 18px 18px 20px; color: var(--muc);[39m
[31m+   background: var(--the-nen); border: 1px solid var(--vien);[39m
[31m+ }[39m
[31m+ .summary-dau { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }[39m
[31m+ .summary-title { font-size: clamp(15px, 3.6vw, 18px); font-weight: 800; letter-spacing: .01em; }[39m
[31m+ .summary-tong { font-size: 13px; color: var(--nhat); font-variant-numeric: tabular-nums; }[39m
[31m+ .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 8px; margin-bottom: 12px; }[39m
[31m+ .stat-card {[39m
[31m+   display: flex; align-items: baseline; gap: 8px; width: 100%; text-align: left;[39m
[31m+   padding: 12px 13px; color: inherit; font: inherit;[39m
[31m+   background: var(--nen); border: 1px solid var(--vien); border-radius: 16px;[39m
[31m+   transition: background-color var(--muot), border-color var(--muot), transform var(--muot);[39m
[31m+ }[39m
[31m+ button.stat-card, button.topic-item { cursor: pointer; }[39m
[31m+ button.stat-card:hover { background: var(--the-nen); border-color: var(--vien-dam); }[39m
[31m+ button.stat-card:active { transform: scale(.98); }[39m
[31m+ /* Ô ĐANG CHỌN: tô bằng chính màu nhấn ở mức rất nhạt + viền đậm, thay cho[39m
[31m+    cách cũ là đảo sang nền trắng — trên nền sáng thì trắng không còn nổi. */[39m
[31m+ button.stat-card.chon { background: var(--the-nen); border-color: var(--nav); color: var(--nav); box-shadow: inset 0 0 0 1px var(--nav); }[39m
[31m+ button.stat-card.chon .stat-label { color: var(--nav); font-weight: 700; }[39m
[31m+ button.stat-card:focus-visible, button.topic-item:focus-visible { outline: 3px solid var(--nav); outline-offset: 2px; }[39m
[31m+ .stat-number { font-size: clamp(19px, 4.4vw, 23px); font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }[39m
[31m+ .stat-label { font-size: 12px; color: var(--nhat); line-height: 1.3; }[39m
[31m+ /* PHÂN LOẠI MỨC ĐỘ.[39m
[31m+    Bản cũ dồn tất cả vào MỘT dòng chữ 13px: tên mức, dãy số câu, số câu, tên[39m
[31m+    chuyên đề nối đuôi nhau. Đọc trên điện thoại là một dải chữ dài không có[39m
[31m+    chỗ nghỉ mắt. Nặng hơn: mỗi dòng mang lề âm -10px trong khung chỉ đệm 14px,[39m
[31m+    nên nền và viền dòng tràn sát mép khung, nhìn như bị cắt cụt.[39m
[31m+    Nay tách hai tầng — tầng trên là TÊN MỨC (đọc trước) kèm chuyên đề mờ,[39m
[31m+    tầng dưới là dãy số câu chữ nhỏ — và dòng nằm gọn hẳn trong khung. */[39m
[31m+ .topics-list { background: var(--nen); border: 1px solid var(--vien); border-radius: 20px; padding: 12px 8px 8px; }[39m
[31m+ .topics-list h3 {[39m
[31m+   font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;[39m
[31m+   color: var(--nhat); margin: 0 0 6px; padding: 0 10px;[39m
[31m+ }[39m
[31m+ .topic-item {[39m
[31m+   display: grid; grid-template-columns: 4px minmax(0, 1fr); align-items: start;[39m
[31m+   gap: 3px 11px; width: 100%; margin: 0; text-align: left;[39m
[31m+   padding: 9px 11px; border: 0; border-radius: 14px;[39m
[31m+   background: transparent; color: inherit; font: inherit;[39m
[31m+   transition: background-color var(--muot), box-shadow var(--muot);[39m
[31m+ }[39m
[31m+ .topic-item + .topic-item { margin-top: 2px; }[39m
[31m+ /* Thanh màu dọc thay cho chấm tròn: dòng cao hai tầng thì chấm tròn lửng lơ,[39m
[31m+    còn thanh chạy hết chiều cao nên neo được cả khối chữ. */[39m
[31m+ .topic-cham { grid-row: 1 / span 2; align-self: stretch; display: block; min-height: 26px; }[39m
[31m+ .topic-dot { display: block; width: 4px; height: 100%; min-height: 26px; border-radius: 999px; }[39m
[31m+ .topic-ten {[39m
[31m+   display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px;[39m
[31m+   font-size: 14px; line-height: 1.35; letter-spacing: -.01em;[39m
[31m+ }[39m
[31m+ .topic-ten strong { font-weight: 700; }[39m
[31m+ .topic-cd { font-size: 12px; font-weight: 500; color: var(--nhat); }[39m
[31m+ .topic-cau {[39m
[31m+   grid-column: 2; font-size: 12px; line-height: 1.55; color: var(--nhat);[39m
[31m+   font-variant-numeric: tabular-nums;[39m
[31m+ }[39m
[31m+ button.topic-item:hover { background: var(--the-nen); }[39m
[31m+ button.topic-item:active { background: var(--the-nen); }[39m
[31m+ button.topic-item.chon { background: var(--the-nen); box-shadow: inset 0 0 0 1.5px var(--nav); }[39m
[31m+ button.topic-item.chon .topic-ten { color: var(--nav); }[39m
[31m+ button.topic-item.chon .topic-cau, button.topic-item.chon .topic-cd { color: var(--nav); opacity: .78; }[39m
