[31m+ .nhac-phieu { background: var(--kem-nen); border: 1px solid var(--kem-vien); border-left: 4px solid var(--kem-nhan); border-radius: 16px; padding: 14px 18px; margin-bottom: 16px; color: var(--kem-muc); font-size: 14px; line-height: 1.55; }[39m
