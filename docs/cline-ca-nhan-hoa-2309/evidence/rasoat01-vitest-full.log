[31m+     ca: {[39m
[31m+       ...(c as unknown as ChiTietCa['ca']),[39m
[31m+       maCa: String(c.maCa ?? ''),[39m
[31m+       lop: String(c.lop ?? ''),[39m
[31m+       // Máy chủ mới KHÔNG giữ hai trường này (chúng chỉ sống trên Sheet). Trả[39m
