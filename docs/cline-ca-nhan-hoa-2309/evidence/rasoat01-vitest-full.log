[31m+           }[39m
[31m+           return[39m
[31m+         }[39m
[31m+[39m
[31m+         // --- KÊNH 5, 6, 8: CHỈ GHI SỔ, không khoá ai (gỡ 06/09). Ngưỡng lọc vẫn[39m
[31m+         // giữ ở đây để nhật ký không ngập nhát yếu — trang /do dùng ngưỡng quan[39m
[31m+         // sát rộng hơn.[39m
[31m+         if (p.kenh === 'nhip_ve') {[39m
[31m+           const gap = Number(/(\d+)/.exec(p.chiTiet)?.[1] ?? 0)[39m
[31m+           if (gap >= MS_RAF_NGHI_CHOT) xetPhieu(p)[39m
[31m+           return[39m
