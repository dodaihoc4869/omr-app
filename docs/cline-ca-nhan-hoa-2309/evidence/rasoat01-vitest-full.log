[31m+     chuyenDe,[39m
[31m+     ca: (r.ca || []).map((c: CaCuaEm) => ({ ...c, maCa: String(c.maCa) })),[39m
[31m+     caGanNhat: r.caGanNhat ? { ...r.caGanNhat, maCa: String(r.caGanNhat.maCa) } : null,[39m
[31m+     chuyenDeCaGanNhat: r.chuyenDeCaGanNhat || [],[39m
[31m+     soCauSaiCaGanNhat: Number(r.soCauSaiCaGanNhat) || 0,[39m
