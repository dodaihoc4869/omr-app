[31m+     // Kim loại: hai cao độ lệch quãng không chỉnh, nghe ra "va vào thứ cứng".[39m
[31m+     this.giong({ tre: T + 0.008, dang: 'square', f0: 412, f1: 302, to: 0.14, giu: 0.03, tat: 0.3,[39m
[31m+       loc: 'bandpass', fLoc: 2100, fLoc1: 780, qLoc: 7, vang: 0.45 })[39m
