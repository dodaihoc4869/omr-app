[31m+     // eslint-disable-next-line react-hooks/exhaustive-deps[39m
[31m+   }, [phase])[39m
[31m+[39m
[31m+   // ==========================================================================[39m
[31m+   // GIỮ ĐỂ ĐỌC — GIUDEDOC.md, effect RIÊNG, không đụng một dòng nào của luật[39m
[31m+   // đếm rời app lẫn bốn tín hiệu khoá của BAOMATCATHI.[39m
[31m+   //[39m
[31m+   // Video 05/09 chứng minh cửa sổ nổi không để lại một bit tín hiệu nào cho[39m
[31m+   // web. Nên thôi tìm cách nhìn thấy nó: đề chỉ hiện khi ngón tay em còn trên[39m
[31m+   // màn thi. Muốn chạm vào cửa sổ nổi thì phải nhả tay, nhả tay thì đề tắt —[39m
[31m+   // không đọc hai thứ cùng lúc được nữa.[39m
[31m+   //[39m
[31m+   // KHÔNG state React: đổi đúng MỘT thuộc tính trên thẻ <html>. Một setState[39m
[31m+   // mỗi lần nhả tay là render lại cả màn 28 câu, mục 5 cấm.[39m
[31m+   // KHÔNG khoá bài vì việc này (mục 9) — đây là hiển thị, không phải xử phạt.[39m
[31m+   useEffect(() => {[39m
[31m+     if (phase !== 'exam') return[39m
[31m+     const a = attemptRef.current[39m
[31m+     if (!a || !batCuaCa(a)) return[39m
[31m+     // MÁY KHÔNG CẢM ỨNG: cơ chế KHÔNG bật (màn thi vốn dựng cho điện thoại; bật[39m
[31m+     // ở máy tính là khoá cứng bài của một em không làm gì sai).[39m
[31m+     //[39m
[31m+     // KHÔNG còn `return` sớm ở đây. Lời khai của máy có thể sai — iPhone bật[39m
[31m+     // "Yêu cầu trang web dành cho máy tính" khai `maxTouchPoints = 0` (thầy báo[39m
