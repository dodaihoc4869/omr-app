{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts",
    "../src/game/giai-cuu-cong-chua/**/*.ts"
  ],
  "exclude": [
    "../src/game/giai-cuu-cong-chua/nhan-vat.ts",
    "../src/game/giai-cuu-cong-chua/ve-van.ts",
    "../src/game/giai-cuu-cong-chua/am-thanh.ts",
    "../src/game/giai-cuu-cong-chua/may-chu.ts",
    "../src/game/giai-cuu-cong-chua/dia-chi-may-chu.ts"
  ]
}
